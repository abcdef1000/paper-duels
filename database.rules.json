{
  "rules": {
    "lobby": {
      ".read": "auth != null",
      "$conn": {
        ".write": "auth != null && (data.exists() ? data.child('by').val() === auth.uid : newData.child('by').val() === auth.uid)",
        ".validate": "newData.child('by').val() === auth.uid && newData.child('p').isString() && newData.child('p').val().length < 4096"
      }
    },
    "data": {
      "users": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "players": {
      ".read": "auth != null",
      ".indexOn": ["mastered"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.child('nick').isString() && newData.child('nick').val().length <= 20 && newData.child('mastered').isNumber()"
      }
    }
  }
}
