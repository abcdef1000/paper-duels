{
  "rules": {
    "lobby": {
      ".read": "auth != null",
      "$conn": {
        ".write": "auth != null && (data.exists() ? data.child('by').val() === auth.uid : newData.child('by').val() === auth.uid)",
        ".validate": "newData.child('by').val() === auth.uid && newData.child('p').isString() && newData.child('p').val().length < 4096"
      }
    },
    "data": {
      "users": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "players": {
      ".read": "auth != null",
      ".indexOn": [
        "mastered"
      ],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.child('nick').isString() && newData.child('nick').val().length <= 20 && newData.child('mastered').isNumber()"
      }
    },
    "daily": {
      ".read": "auth != null",
      "$bk": {
        "$day": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && !data.exists()",
            ".validate": "newData.child('score').isNumber() && newData.child('score').val() >= 0 && newData.child('score').val() <= 1000 && newData.child('nick').isString() && newData.child('nick').val().length <= 20"
          }
        }
      }
    },
    "packMeta": {
      ".read": "auth != null",
      ".indexOn": [
        "t"
      ],
      "$id": {
        ".write": "auth != null && (data.exists() ? data.child('owner').val() === auth.uid : newData.child('owner').val() === auth.uid)",
        ".validate": "newData.child('owner').val() === auth.uid && newData.child('name').isString() && newData.child('name').val().length <= 60 && newData.child('n').isNumber()"
      }
    },
    "packData": {
      "$id": {
        ".read": "auth != null",
        ".write": "auth != null && (data.exists() ? data.child('owner').val() === auth.uid : newData.child('owner').val() === auth.uid)",
        ".validate": "newData.child('owner').val() === auth.uid && newData.child('json').isString() && newData.child('json').val().length < 200000"
      }
    }
  }
}
