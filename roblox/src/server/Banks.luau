			{ id = "ACC-02", topic = "Alternating Current", quick = true, q = "An ideal transformer steps 240 V down to 12 V. The secondary current is 2.0 A. What is the primary current?", o = { "0.050 A", "0.10 A", "2.0 A", "40 A" }, a = 2, x = "Ideal transformer: VₚIₚ = VₛIₛ, so Iₚ = (12 × 2.0)/240 = 0.10 A." },
			{ id = "ACC-03", topic = "Alternating Current", quick = true, q = "A sinusoidal current of peak value I₀ flows through a resistor of resistance R. What is the mean power dissipated?", o = { "I₀²R", "I₀²R/√2", "I₀²R/2", "2I₀²R" }, a = 3, x = "⟨P⟩ = I_rms²R = (I₀/√2)²R = I₀²R/2." },
			{ id = "QUA-01", topic = "Quantum Physics", quick = false, q = "What is the energy of a photon of wavelength 500 nm?", o = { "1.2 eV", "2.5 eV", "4.0 eV", "6.2 eV" }, a = 2, x = "E = hc/λ = (6.63 × 10⁻³⁴ × 3.00 × 10⁸)/(500 × 10⁻⁹) = 3.98 × 10⁻¹⁹ J = 2.5 eV." },
			{ id = "QUA-02", topic = "Quantum Physics", quick = true, q = "Photons of energy 3.5 eV fall on a metal of work function 2.3 eV. What is the stopping potential?", o = { "1.2 V", "2.3 V", "3.5 V", "5.8 V" }, a = 1, x = "KE_max = hf − Φ = 3.5 − 2.3 = 1.2 eV. eV_s = KE_max, so V_s = 1.2 V." },
			{ id = "QUA-03", topic = "Quantum Physics", quick = false, q = "An electron starts from rest and is accelerated through a potential difference of 100 V. What is its de Broglie wavelength?", o = { "1.2 × 10⁻¹² m", "1.2 × 10⁻¹⁰ m", "3.9 × 10⁻¹⁰ m", "7.3 × 10⁻⁶ m" }, a = 2, x = "p = √(2meV) = √(2 × 9.11 × 10⁻³¹ × 1.60 × 10⁻¹⁹ × 100) = 5.4 × 10⁻²⁴ kg m s⁻¹. λ = h/p = 1.2 × 10⁻¹⁰ m." },
			{ id = "QUA-04", topic = "Quantum Physics", quick = true, q = "An electron is confined in a one-dimensional infinite potential well. What is the ratio (energy of the n = 3 state)/(energy of the ground state)?", o = { "3", "4", "6", "9" }, a = 4, x = "Eₙ = n²h²/(8mL²), so E ∝ n². E₃/E₁ = 9." },
			{ id = "QUA-05", topic = "Quantum Physics", quick = true, q = "In a photoelectric experiment, the intensity of the incident light is doubled while its frequency stays the same. What happens?", o = { "The maximum kinetic energy of the photoelectrons doubles.", "The stopping potential doubles.", "The rate of photoelectron emission doubles, and their maximum kinetic energy is unchanged.", "The threshold frequency halves." }, a = 3, x = "Intensity sets the number of photons per second, and so the emission rate. Each photon's energy hf is unchanged, so KE_max and the stopping potential stay the same." },
			{ id = "NUC-01", topic = "Nuclear Physics", quick = true, q = "The activity of a radioactive sample falls from 800 Bq to 50 Bq in 24 days. What is its half-life?", o = { "3 days", "6 days", "8 days", "12 days" }, a = 2, x = "800 → 400 → 200 → 100 → 50 is 4 half-lives. 24/4 = 6 days." },
			{ id = "NUC-02", topic = "Nuclear Physics", quick = true, q = "A nucleus of uranium-238 (Z = 92) emits one α-particle and then two β⁻ particles. What is the resulting nucleus?", o = { "mass number 234, proton number 88", "mass number 234, proton number 90", "mass number 234, proton number 92", "mass number 236, proton number 92" }, a = 3, x = "α: A − 4, Z − 2, giving A = 234, Z = 90. Each β⁻ raises Z by 1, giving Z = 92. It is uranium-234." },
			{ id = "NUC-03", topic = "Nuclear Physics", quick = false, q = "The mass defect of a helium-4 nucleus is 0.0304 u. What is its binding energy per nucleon?", o = { "3.5 MeV", "7.1 MeV", "14.2 MeV", "28.3 MeV" }, a = 2, x = "BE = 0.0304 × 931.5 = 28.3 MeV, shared by 4 nucleons: 7.1 MeV per nucleon." },
			{ id = "NUC-04", topic = "Nuclear Physics", quick = true, q = "Which statement about nuclear fission of a heavy nucleus is correct?", o = { "The total binding energy of the products is less than that of the original nucleus.", "The binding energy per nucleon of the products is greater than that of the original nucleus.", "The total mass of the products is greater than the mass of the original nucleus.", "Energy must be supplied continuously to keep the products apart." }, a = 2, x = "Fission moves nuclei towards the iron peak of the BE-per-nucleon curve. The products are more tightly bound, and the mass lost appears as released energy." },
		},
	},
	sci = {
		name = "PSLE Science",
		constants = "",
		questions = {
			{ id = "PS-LIV-01", topic = "Living and Non-living Things", quick = true, q = "Which statement is true of all living things?", o = { "They need food, water and air.", "They can move from place to place.", "They breathe through lungs.", "They make their own food." }, a = 1, x = "All living things need food, water and air, grow, respond and reproduce. Plants don't move from place to place, many animals have no lungs, and only plants make their own food." },
			{ id = "PS-LIV-02", topic = "Living and Non-living Things", quick = true, q = "Which of these is NOT a living thing?", o = { "mushroom", "fern", "fire", "yeast" }, a = 3, x = "Fire uses air and spreads, but it cannot reproduce, grow from food or respond to changes like living things do. Mushrooms and yeast are fungi, and ferns are plants." },
			{ id = "PS-CLA-01", topic = "Classification", quick = true, q = "Which characteristic shows that a mushroom is NOT a plant?", o = { "It cannot make its own food.", "It reproduces by spores.", "It grows in damp places.", "It does not have flowers." }, a = 1, x = "Plants make their own food by photosynthesis, but fungi such as mushrooms cannot. Ferns also reproduce by spores, grow in damp places and have no flowers, so those don't separate fungi from plants." },
			{ id = "PS-CLA-02", topic = "Classification", quick = true, q = "Which animal is a mammal?", o = { "penguin", "whale", "shark", "crocodile" }, a = 2, x = "Mammals feed their young on milk and have hair or fur at some stage. A whale is a mammal that lives in water. A penguin is a bird, a shark is a fish and a crocodile is a reptile." },
			{ id = "PS-CLA-03", topic = "Classification", quick = true, q = "An animal has six legs, three body parts and one pair of antennae. What is it?", o = { "an insect", "a spider", "a millipede", "a crab" }, a = 1, x = "Six legs and three body parts (head, thorax, abdomen) define an insect. A spider has eight legs and two body parts." },
			{ id = "PS-MAT-01", topic = "Materials", quick = true, q = "What property should the material for a frying-pan handle have?", o = { "It is a good conductor of heat.", "It is a poor conductor of heat.", "It is flexible.", "It is transparent." }, a = 2, x = "A handle made of a poor conductor of heat, such as plastic or wood, does not get hot quickly, so it can be held safely." },
			{ id = "PS-MAT-02", topic = "Materials", quick = true, q = "A window must let light through and keep rain out. Which material is most suitable?", o = { "glass", "wood", "aluminium", "cardboard" }, a = 1, x = "Glass is transparent and waterproof. Wood and aluminium block light, and cardboard soaks up water." },
			{ id = "PS-MAT-03", topic = "Materials", quick = true, q = "Equal-sized pieces of materials W, X, Y and Z were each dipped into 100 ml of water and then removed. The water left was: W 60 ml, X 85 ml, Y 40 ml, Z 95 ml. Which material is best for making a mop?", o = { "W", "X", "Y", "Z" }, a = 3, x = "The best mop material absorbs the most water. Y left only 40 ml, so it absorbed 100 − 40 = 60 ml, the most of the four." },
			{ id = "PS-LC-01", topic = "Life Cycles", quick = true, q = "Which animal has a three-stage life cycle?", o = { "butterfly", "mosquito", "cockroach", "beetle" }, a = 3, x = "A cockroach goes egg → nymph → adult. Butterflies, mosquitoes and beetles have four stages: egg, larva, pupa, adult." },
			{ id = "PS-LC-02", topic = "Life Cycles", quick = true, q = "In which stage of its life cycle does a butterfly eat the most?", o = { "egg", "larva (caterpillar)", "pupa", "adult" }, a = 2, x = "The caterpillar eats leaves constantly and grows quickly. The pupa does not feed at all." },
			{ id = "PS-LC-03", topic = "Life Cycles", quick = true, q = "Which stage of a frog's life cycle lives only in water and breathes using gills?", o = { "egg", "tadpole", "froglet", "adult frog" }, a = 2, x = "A tadpole lives in water and breathes with gills. The froglet and adult frog develop lungs and can live on land." },
			{ id = "PS-REP-01", topic = "Reproduction", quick = true, q = "A fruit is light and has wing-like parts. How is it most likely dispersed?", o = { "by wind", "by water", "by animals", "by splitting open" }, a = 1, x = "Light fruits with wings or hairs are carried far by the wind. Fibrous, air-filled fruits float on water, and juicy or hooked fruits are spread by animals." },
			{ id = "PS-REP-02", topic = "Reproduction", quick = true, q = "What is pollination?", o = { "the transfer of pollen grains from the anther to the stigma", "the joining of the male and female reproductive cells", "the growth of a seed into a young plant", "the movement of seeds away from the parent plant" }, a = 1, x = "Pollination is the transfer of pollen from the anther to the stigma. Fertilisation is the joining of reproductive cells, germination is a seed growing, and dispersal is seeds moving away." },
			{ id = "PS-REP-03", topic = "Reproduction", quick = true, q = "In human reproduction, what happens during fertilisation?", o = { "A sperm fuses with an egg.", "The egg is released from the ovary.", "The baby develops in the womb.", "Sperm are produced in the testes." }, a = 1, x = "Fertilisation is the fusion of a sperm with an egg to form a fertilised egg, which then develops in the womb." },
			{ id = "PS-MW-01", topic = "Matter and Water", quick = true, q = "Which state of matter has a definite volume but no definite shape?", o = { "solid", "liquid", "gas", "all three" }, a = 2, x = "A liquid keeps its volume but takes the shape of its container. A solid has a definite shape and volume. A gas has neither." },
			{ id = "PS-MW-02", topic = "Matter and Water", quick = true, q = "Water droplets form on the outside of a glass of ice water. Why?", o = { "Water seeps through the glass.", "Water vapour in the surrounding air loses heat to the cold glass and condenses.", "The ice melts and evaporates out of the glass.", "The cold glass gives off water vapour." }, a = 2, x = "Water vapour in the air touches the cold glass, loses heat and condenses into droplets. The water does not come from inside the glass." },
			{ id = "PS-MW-03", topic = "Matter and Water", quick = true, q = "Which conditions will dry a wet towel the fastest?", o = { "folded, in the shade, no wind", "spread out, in the sun, windy", "spread out, in the shade, no wind", "folded, in the sun, windy" }, a = 2, x = "Evaporation is faster with a larger exposed surface area, higher temperature and more wind." },
			{ id = "PS-MW-04", topic = "Matter and Water", quick = true, q = "How are clouds formed?", o = { "Water vapour rises, loses heat and condenses into tiny water droplets.", "Water in the sea boils and rises into the sky.", "Smoke from factories collects in the sky.", "Rain droplets freeze high in the sky." }, a = 1, x = "Warm water vapour rises, cools as it loses heat, and condenses into tiny water droplets that form clouds." },
			{ id = "PS-MW-05", topic = "Matter and Water", quick = true, q = "A ball becomes heavier after more air is pumped into it. What does this show?", o = { "Air has mass.", "Air takes the shape of its container.", "Air can be compressed.", "Air is a mixture of gases." }, a = 1, x = "The extra mass comes from the air pumped in, so air has mass." },
			{ id = "PS-PS-01", topic = "Plant Systems", quick = true, q = "Which part of a plant carries water from the roots to the leaves?", o = { "food-carrying tubes", "water-carrying tubes", "stomata", "root hairs" }, a = 2, x = "Water-carrying tubes transport water and mineral salts up from the roots. Food-carrying tubes carry food made in the leaves to other parts." },
			{ id = "PS-PS-02", topic = "Plant Systems", quick = true, q = "A ring of bark, including the food-carrying tubes, is removed from a tree's stem. After a few weeks the stem just above the ring swells. Why?", o = { "Water collects above the ring.", "Food made in the leaves cannot move down past the ring.", "The roots cannot absorb water.", "The leaves stop making food." }, a = 2, x = "The food-carrying tubes were removed, so food moving down from the leaves builds up just above the ring and the stem swells there." },
			{ id = "PS-HS-01", topic = "Human Systems", quick = true, q = "In which part of the digestive system is digestion completed?", o = { "stomach", "small intestine", "large intestine", "gullet" }, a = 2, x = "Digestion is completed in the small intestine, where digested food is also absorbed into the blood." },
			{ id = "PS-HS-02", topic = "Human Systems", quick = true, q = "What is the main function of the lungs?", o = { "to pump blood around the body", "to take in oxygen and remove carbon dioxide", "to digest food", "to remove water from the blood" }, a = 2, x = "In the lungs, oxygen passes into the blood and carbon dioxide is removed. The heart pumps blood." },
			{ id = "PS-HS-03", topic = "Human Systems", quick = true, q = "In which of these parts does NO digestion of food take place?", o = { "mouth", "stomach", "small intestine", "gullet" }, a = 4, x = "The gullet only moves food from the mouth to the stomach. Digestion happens in the mouth, stomach and small intestine." },
			{ id = "PS-CEL-01", topic = "Cells", quick = true, q = "Which parts are found in a plant cell but NOT in an animal cell?", o = { "cell wall and chloroplasts", "nucleus and cytoplasm", "cell membrane and nucleus", "cytoplasm and cell membrane" }, a = 1, x = "Plant cells have a cell wall for shape and chloroplasts for photosynthesis. Both cell types have a nucleus, cytoplasm and cell membrane." },
			{ id = "PS-CEL-02", topic = "Cells", quick = true, q = "Which part of a cell controls all its activities?", o = { "nucleus", "cytoplasm", "cell membrane", "cell wall" }, a = 1, x = "The nucleus controls the activities of the cell. The cell membrane controls what enters and leaves." },
			{ id = "PS-ES-02", topic = "Electrical Systems", quick = true, q = "Which object, placed across a gap in a circuit, will make the bulb light up?", o = { "steel paper clip", "rubber band", "plastic ruler", "wooden chopstick" }, a = 1, x = "Steel is a metal, which is an electrical conductor. Rubber, plastic and wood are insulators." },
			{ id = "PS-ES-03", topic = "Electrical Systems", quick = true, q = "Two bulbs are connected in series to a battery. One bulb fuses. What happens to the other bulb?", o = { "It gets brighter.", "It stays the same.", "It goes out, because the circuit is broken.", "It flickers." }, a = 3, x = "In series there is only one path for the current. A fused bulb breaks that path, so no current flows and the other bulb goes out." },
			{ id = "PS-LT-01", topic = "Light", quick = true, q = "Why can we see a book in a lit room?", o = { "Light from the book's own glow enters our eyes.", "Light reflected off the book enters our eyes.", "Light from our eyes falls on the book.", "The book absorbs all the light." }, a = 2, x = "A book is not a light source. Light from a lamp or the sun reflects off the book and enters our eyes." },
			{ id = "PS-HT-01", topic = "Heat", quick = true, q = "A metal spoon placed in hot soup becomes hot. Why?", o = { "Heat flows from the soup to the spoon.", "Cold flows from the spoon to the soup.", "The spoon produces heat.", "Heat flows from the spoon to the soup." }, a = 1, x = "Heat always flows from a hotter object to a colder one, here from the soup into the spoon. There is no such thing as cold flowing." },
			{ id = "PS-HT-02", topic = "Heat", quick = true, q = "Why are small gaps left between sections of a railway track?", o = { "to save metal", "to let rainwater drain away", "to allow the metal to expand when it gains heat", "to make the train run more quietly" }, a = 3, x = "Metal expands when it gains heat. Without gaps, the rails would push against each other and bend on hot days." },
			{ id = "PS-HT-03", topic = "Heat", quick = true, q = "A dented ping-pong ball regains its shape when placed in hot water. Why?", o = { "The water enters the ball.", "The air inside the ball gains heat and expands.", "The plastic shrinks in hot water.", "The air inside loses heat and contracts." }, a = 2, x = "Air inside the ball gains heat from the hot water and expands, pushing the dent out." },
			{ id = "PS-EC-01", topic = "Energy Conversion", quick = true, q = "Which are needed for photosynthesis?", o = { "water, carbon dioxide and light", "water, oxygen and light", "oxygen, carbon dioxide and food", "food, water and light" }, a = 1, x = "Plants use light energy, water and carbon dioxide to make food (sugar), giving off oxygen. Oxygen is a product, not a need." },
			{ id = "PS-EC-02", topic = "Energy Conversion", quick = true, q = "What are the energy conversions in a battery-powered torch?", o = { "chemical potential → electrical → light and heat", "electrical → chemical potential → light", "light → electrical → heat", "kinetic → electrical → light" }, a = 1, x = "The battery's chemical potential energy becomes electrical energy, which the bulb converts into light and heat." },
			{ id = "PS-EC-03", topic = "Energy Conversion", quick = true, q = "A ball is dropped and bounces. Each bounce is lower than the last. Why?", o = { "Energy is destroyed at each bounce.", "Some energy is converted into heat and sound at each bounce.", "Gravity becomes stronger.", "The ball loses mass." }, a = 2, x = "Energy cannot be destroyed. Some is converted to heat and sound at each bounce, so less is left to lift the ball." },
			{ id = "PS-MG-01", topic = "Magnets", quick = true, q = "Which object will a magnet attract?", o = { "aluminium can", "copper wire", "iron nail", "plastic spoon" }, a = 3, x = "Magnets attract magnetic materials such as iron, steel, nickel and cobalt. Aluminium and copper are metals but not magnetic." },
			{ id = "PS-MG-02", topic = "Magnets", quick = true, q = "The north pole of one magnet is brought near the north pole of another. What happens?", o = { "They attract.", "They repel.", "Nothing happens.", "Both become non-magnetic." }, a = 2, x = "Like poles repel and unlike poles attract." },
			{ id = "PS-MG-03", topic = "Magnets", quick = true, q = "Which change makes an electromagnet stronger?", o = { "using fewer coils of wire", "using more coils of wire", "using a plastic core", "using fewer batteries" }, a = 2, x = "More coils of wire (or more batteries) makes an electromagnet stronger. An iron core helps too. Plastic does not." },
			{ id = "PS-FO-02", topic = "Forces", quick = true, q = "Why do hiking shoes have soles with deep grooves?", o = { "to reduce friction", "to increase friction", "to make the shoes lighter", "to reduce gravity" }, a = 2, x = "Deep grooves increase friction between the shoe and the ground, so the hiker is less likely to slip." },
			{ id = "PS-FO-03", topic = "Forces", quick = true, q = "Which force makes an apple fall from a tree?", o = { "magnetic force", "frictional force", "gravitational force", "elastic spring force" }, a = 3, x = "Gravitational force is the pull of the Earth on objects. It pulls the apple down." },
			{ id = "PS-ENV-02", topic = "Environment", quick = true, q = "A cactus has spines instead of broad leaves. How does this help it survive in the desert?", o = { "It reduces water loss.", "It makes more food.", "It attracts insects.", "It absorbs more sunlight." }, a = 1, x = "Spines have a much smaller surface area than leaves, so less water is lost. They also protect the cactus from animals." },
			{ id = "PS-ENV-03", topic = "Environment", quick = true, q = "Which is a direct result of clearing large areas of forest?", o = { "Animals lose their habitats.", "There is more oxygen in the air.", "There is less carbon dioxide in the air.", "There are more food sources for animals." }, a = 1, x = "Clearing forests destroys the homes of many organisms. It also leaves fewer trees to take in carbon dioxide." },
			{ id = "PS-ENV-04", topic = "Environment", quick = true, q = "What is the role of decomposers such as fungi and bacteria?", o = { "They break down dead matter and return nutrients to the soil.", "They make food using sunlight.", "They eat only living plants.", "They pollinate flowers." }, a = 1, x = "Decomposers break down dead plants and animals, returning nutrients to the soil for plants to use." },
		},
	},
	math = {
		name = "PSLE Maths",
		constants = "",
		questions = {
			{ id = "PM-WN-01", topic = "Whole Numbers", quick = true, q = "In 470 582, which digit is in the thousands place?", o = { "4", "7", "0", "5" }, a = 3, x = "470 582 = 4 hundred thousands, 7 ten thousands, 0 thousands, 5 hundreds, 8 tens, 2 ones." },
			{ id = "PM-WN-02", topic = "Whole Numbers", quick = true, q = "Round 64 950 to the nearest thousand.", o = { "64 000", "64 900", "65 000", "70 000" }, a = 3, x = "The hundreds digit is 9 (5 or more), so round up: 64 950 → 65 000." },
			{ id = "PM-WN-03", topic = "Whole Numbers", quick = true, q = "Find the value of 8 + 12 ÷ 4 × 2.", o = { "9.5", "10", "14", "40" }, a = 3, x = "Divide and multiply from left to right before adding: 12 ÷ 4 = 3, 3 × 2 = 6, then 8 + 6 = 14." },
			{ id = "PM-WN-04", topic = "Whole Numbers", quick = true, q = "What is the smallest number that is a multiple of both 6 and 8?", o = { "2", "14", "24", "48" }, a = 3, x = "Multiples of 8: 8, 16, 24… The first one that is also a multiple of 6 is 24." },
			{ id = "PM-FR-01", topic = "Fractions", quick = true, q = "Find the value of 3/4 − 1/6.", o = { "1/2", "5/12", "7/12", "2/10" }, a = 3, x = "Use twelfths: 9/12 − 2/12 = 7/12." },
			{ id = "PM-FR-02", topic = "Fractions", quick = true, q = "What is 2/5 of 45?", o = { "9", "18", "27", "36" }, a = 2, x = "1/5 of 45 is 9, so 2/5 is 18." },
			{ id = "PM-FR-03", topic = "Fractions", quick = true, q = "Find the value of 3 ÷ 1/4.", o = { "3/4", "4/3", "7", "12" }, a = 4, x = "Dividing by 1/4 is the same as multiplying by 4: 3 × 4 = 12. There are 12 quarters in 3." },
			{ id = "PM-FR-04", topic = "Fractions", quick = true, q = "Which fraction is the largest?", o = { "5/8", "2/3", "3/5", "7/12" }, a = 2, x = "Over 120: 5/8 = 75/120, 2/3 = 80/120, 3/5 = 72/120, 7/12 = 70/120. 2/3 is the largest." },
			{ id = "PM-DE-01", topic = "Decimals", quick = true, q = "Find the value of 0.4 × 0.3.", o = { "0.012", "0.12", "1.2", "0.7" }, a = 2, x = "4 × 3 = 12, and there are two decimal places in total, so 0.12." },
			{ id = "PM-DE-02", topic = "Decimals", quick = true, q = "Find the value of 3.6 ÷ 0.06.", o = { "0.6", "6", "60", "600" }, a = 3, x = "Multiply both by 100: 360 ÷ 6 = 60." },
			{ id = "PM-DE-03", topic = "Decimals", quick = true, q = "Express 2 7/20 as a decimal.", o = { "2.14", "2.35", "2.7", "2.72" }, a = 2, x = "7/20 = 35/100 = 0.35, so 2 7/20 = 2.35." },
			{ id = "PM-PC-01", topic = "Percentage", quick = true, q = "What is 15% of 80?", o = { "1.2", "5.3", "12", "65" }, a = 3, x = "10% of 80 is 8 and 5% is 4, so 15% is 12." },
			{ id = "PM-PC-02", topic = "Percentage", quick = true, q = "A bag costs $60 after a 25% discount. What was its original price?", o = { "$45", "$75", "$80", "$85" }, a = 3, x = "$60 is 75% of the original price. 25% is $20, so 100% is $80." },
			{ id = "PM-PC-03", topic = "Percentage", quick = true, q = "A 9% tax is added to a $200 item. What is the total price?", o = { "$180", "$209", "$218", "$290" }, a = 3, x = "9% of $200 is $18, so the total is $218." },
			{ id = "PM-PC-04", topic = "Percentage", quick = true, q = "The number of pupils in a club rose from 40 to 50. What is the percentage increase?", o = { "10%", "20%", "25%", "80%" }, a = 3, x = "The increase of 10 is compared with the original 40: 10/40 = 1/4 = 25%." },
			{ id = "PM-RA-01", topic = "Ratio", quick = true, q = "Ali and Ben share $90 in the ratio 2 : 3. How much does Ben get?", o = { "$18", "$36", "$45", "$54" }, a = 4, x = "There are 5 units in total, so 1 unit = $18. Ben gets 3 units = $54." },
			{ id = "PM-RA-02", topic = "Ratio", quick = true, q = "The ratio of boys to girls in a hall is 3 : 5. There are 30 girls. How many boys are there?", o = { "15", "18", "48", "50" }, a = 2, x = "5 units = 30, so 1 unit = 6 and the boys are 3 units = 18." },
