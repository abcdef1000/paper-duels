			{ id = "ACC-02", topic = "Alternating Current", quick = true, q = "An ideal transformer steps 240 V down to 12 V. The secondary current is 2.0 A. What is the primary current?", o = { "0.050 A", "0.10 A", "2.0 A", "40 A" }, a = 2, x = "Ideal transformer: VₚIₚ = VₛIₛ, so Iₚ = (12 × 2.0)/240 = 0.10 A." },
			{ id = "ACC-03", topic = "Alternating Current", quick = true, q = "A sinusoidal current of peak value I₀ flows through a resistor of resistance R. What is the mean power dissipated?", o = { "I₀²R", "I₀²R/√2", "I₀²R/2", "2I₀²R" }, a = 3, x = "⟨P⟩ = I_rms²R = (I₀/√2)²R = I₀²R/2." },
			{ id = "QUA-01", topic = "Quantum Physics", quick = false, q = "What is the energy of a photon of wavelength 500 nm?", o = { "1.2 eV", "2.5 eV", "4.0 eV", "6.2 eV" }, a = 2, x = "E = hc/λ = (6.63 × 10⁻³⁴ × 3.00 × 10⁸)/(500 × 10⁻⁹) = 3.98 × 10⁻¹⁹ J = 2.5 eV." },
			{ id = "QUA-02", topic = "Quantum Physics", quick = true, q = "Photons of energy 3.5 eV fall on a metal of work function 2.3 eV. What is the stopping potential?", o = { "1.2 V", "2.3 V", "3.5 V", "5.8 V" }, a = 1, x = "KE_max = hf − Φ = 3.5 − 2.3 = 1.2 eV. eV_s = KE_max, so V_s = 1.2 V." },
			{ id = "QUA-03", topic = "Quantum Physics", quick = false, q = "An electron starts from rest and is accelerated through a potential difference of 100 V. What is its de Broglie wavelength?", o = { "1.2 × 10⁻¹² m", "1.2 × 10⁻¹⁰ m", "3.9 × 10⁻¹⁰ m", "7.3 × 10⁻⁶ m" }, a = 2, x = "p = √(2meV) = √(2 × 9.11 × 10⁻³¹ × 1.60 × 10⁻¹⁹ × 100) = 5.4 × 10⁻²⁴ kg m s⁻¹. λ = h/p = 1.2 × 10⁻¹⁰ m." },
			{ id = "QUA-04", topic = "Quantum Physics", quick = true, q = "An electron is confined in a one-dimensional infinite potential well. What is the ratio (energy of the n = 3 state)/(energy of the ground state)?", o = { "3", "4", "6", "9" }, a = 4, x = "Eₙ = n²h²/(8mL²), so E ∝ n². E₃/E₁ = 9." },
			{ id = "QUA-05", topic = "Quantum Physics", quick = true, q = "In a photoelectric experiment, the intensity of the incident light is doubled while its frequency stays the same. What happens?", o = { "The maximum kinetic energy of the photoelectrons doubles.", "The stopping potential doubles.", "The rate of photoelectron emission doubles, and their maximum kinetic energy is unchanged.", "The threshold frequency halves." }, a = 3, x = "Intensity sets the number of photons per second, and so the emission rate. Each photon's energy hf is unchanged, so KE_max and the stopping potential stay the same." },
			{ id = "NUC-01", topic = "Nuclear Physics", quick = true, q = "The activity of a radioactive sample falls from 800 Bq to 50 Bq in 24 days. What is its half-life?", o = { "3 days", "6 days", "8 days", "12 days" }, a = 2, x = "800 → 400 → 200 → 100 → 50 is 4 half-lives. 24/4 = 6 days." },
			{ id = "NUC-02", topic = "Nuclear Physics", quick = true, q = "A nucleus of uranium-238 (Z = 92) emits one α-particle and then two β⁻ particles. What is the resulting nucleus?", o = { "mass number 234, proton number 88", "mass number 234, proton number 90", "mass number 234, proton number 92", "mass number 236, proton number 92" }, a = 3, x = "α: A − 4, Z − 2, giving A = 234, Z = 90. Each β⁻ raises Z by 1, giving Z = 92. It is uranium-234." },
			{ id = "NUC-03", topic = "Nuclear Physics", quick = false, q = "The mass defect of a helium-4 nucleus is 0.0304 u. What is its binding energy per nucleon?", o = { "3.5 MeV", "7.1 MeV", "14.2 MeV", "28.3 MeV" }, a = 2, x = "BE = 0.0304 × 931.5 = 28.3 MeV, shared by 4 nucleons: 7.1 MeV per nucleon." },
			{ id = "NUC-04", topic = "Nuclear Physics", quick = true, q = "Which statement about nuclear fission of a heavy nucleus is correct?", o = { "The total binding energy of the products is less than that of the original nucleus.", "The binding energy per nucleon of the products is greater than that of the original nucleus.", "The total mass of the products is greater than the mass of the original nucleus.", "Energy must be supplied continuously to keep the products apart." }, a = 2, x = "Fission moves nuclei towards the iron peak of the BE-per-nucleon curve. The products are more tightly bound, and the mass lost appears as released energy." },
		},
	},
	sci = {
		name = "PSLE Science",
		constants = "",
		questions = {
			{ id = "PS-LIV-01", topic = "Living and Non-living Things", quick = true, q = "Which statement is true of all living things?", o = { "They need food, water and air.", "They can move from place to place.", "They breathe through lungs.", "They make their own food." }, a = 1, x = "All living things need food, water and air, grow, respond and reproduce. Plants don't move from place to place, many animals have no lungs, and only plants make their own food." },
			{ id = "PS-LIV-02", topic = "Living and Non-living Things", quick = true, q = "Which of these is NOT a living thing?", o = { "mushroom", "fern", "fire", "yeast" }, a = 3, x = "Fire uses air and spreads, but it cannot reproduce, grow from food or respond to changes like living things do. Mushrooms and yeast are fungi, and ferns are plants." },
			{ id = "PS-CLA-01", topic = "Classification", quick = true, q = "Which characteristic shows that a mushroom is NOT a plant?", o = { "It cannot make its own food.", "It reproduces by spores.", "It grows in damp places.", "It does not have flowers." }, a = 1, x = "Plants make their own food by photosynthesis, but fungi such as mushrooms cannot. Ferns also reproduce by spores, grow in damp places and have no flowers, so those don't separate fungi from plants." },
			{ id = "PS-CLA-02", topic = "Classification", quick = true, q = "Which animal is a mammal?", o = { "penguin", "whale", "shark", "crocodile" }, a = 2, x = "Mammals feed their young on milk and have hair or fur at some stage. A whale is a mammal that lives in water. A penguin is a bird, a shark is a fish and a crocodile is a reptile." },
			{ id = "PS-CLA-03", topic = "Classification", quick = true, q = "An animal has six legs, three body parts and one pair of antennae. What is it?", o = { "an insect", "a spider", "a millipede", "a crab" }, a = 1, x = "Six legs and three body parts (head, thorax, abdomen) define an insect. A spider has eight legs and two body parts." },
			{ id = "PS-MAT-01", topic = "Materials", quick = true, q = "What property should the material for a frying-pan handle have?", o = { "It is a good conductor of heat.", "It is a poor conductor of heat.", "It is flexible.", "It is transparent." }, a = 2, x = "A handle made of a poor conductor of heat, such as plastic or wood, does not get hot quickly, so it can be held safely." },
			{ id = "PS-MAT-02", topic = "Materials", quick = true, q = "A window must let light through and keep rain out. Which material is most suitable?", o = { "glass", "wood", "aluminium", "cardboard" }, a = 1, x = "Glass is transparent and waterproof. Wood and aluminium block light, and cardboard soaks up water." },
			{ id = "PS-MAT-03", topic = "Materials", quick = true, q = "Equal-sized pieces of materials W, X, Y and Z were each dipped into 100 ml of water and then removed. The water left was: W 60 ml, X 85 ml, Y 40 ml, Z 95 ml. Which material is best for making a mop?", o = { "W", "X", "Y", "Z" }, a = 3, x = "The best mop material absorbs the most water. Y left only 40 ml, so it absorbed 100 − 40 = 60 ml, the most of the four." },
			{ id = "PS-LC-01", topic = "Life Cycles", quick = true, q = "Which animal has a three-stage life cycle?", o = { "butterfly", "mosquito", "cockroach", "beetle" }, a = 3, x = "A cockroach goes egg → nymph → adult. Butterflies, mosquitoes and beetles have four stages: egg, larva, pupa, adult." },
			{ id = "PS-LC-02", topic = "Life Cycles", quick = true, q = "In which stage of its life cycle does a butterfly eat the most?", o = { "egg", "larva (caterpillar)", "pupa", "adult" }, a = 2, x = "The caterpillar eats leaves constantly and grows quickly. The pupa does not feed at all." },
			{ id = "PS-LC-03", topic = "Life Cycles", quick = true, q = "Which stage of a frog's life cycle lives only in water and breathes using gills?", o = { "egg", "tadpole", "froglet", "adult frog" }, a = 2, x = "A tadpole lives in water and breathes with gills. The froglet and adult frog develop lungs and can live on land." },
			{ id = "PS-REP-01", topic = "Reproduction", quick = true, q = "A fruit is light and has wing-like parts. How is it most likely dispersed?", o = { "by wind", "by water", "by animals", "by splitting open" }, a = 1, x = "Light fruits with wings or hairs are carried far by the wind. Fibrous, air-filled fruits float on water, and juicy or hooked fruits are spread by animals." },
			{ id = "PS-REP-02", topic = "Reproduction", quick = true, q = "What is pollination?", o = { "the transfer of pollen grains from the anther to the stigma", "the joining of the male and female reproductive cells", "the growth of a seed into a young plant", "the movement of seeds away from the parent plant" }, a = 1, x = "Pollination is the transfer of pollen from the anther to the stigma. Fertilisation is the joining of reproductive cells, germination is a seed growing, and dispersal is seeds moving away." },
			{ id = "PS-REP-03", topic = "Reproduction", quick = true, q = "In human reproduction, what happens during fertilisation?", o = { "A sperm fuses with an egg.", "The egg is released from the ovary.", "The baby develops in the womb.", "Sperm are produced in the testes." }, a = 1, x = "Fertilisation is the fusion of a sperm with an egg to form a fertilised egg, which then develops in the womb." },
			{ id = "PS-MW-01", topic = "Matter and Water", quick = true, q = "Which state of matter has a definite volume but no definite shape?", o = { "solid", "liquid", "gas", "all three" }, a = 2, x = "A liquid keeps its volume but takes the shape of its container. A solid has a definite shape and volume. A gas has neither." },
			{ id = "PS-MW-02", topic = "Matter and Water", quick = true, q = "Water droplets form on the outside of a glass of ice water. Why?", o = { "Water seeps through the glass.", "Water vapour in the surrounding air loses heat to the cold glass and condenses.", "The ice melts and evaporates out of the glass.", "The cold glass gives off water vapour." }, a = 2, x = "Water vapour in the air touches the cold glass, loses heat and condenses into droplets. The water does not come from inside the glass." },
			{ id = "PS-MW-03", topic = "Matter and Water", quick = true, q = "Which conditions will dry a wet towel the fastest?", o = { "folded, in the shade, no wind", "spread out, in the sun, windy", "spread out, in the shade, no wind", "folded, in the sun, windy" }, a = 2, x = "Evaporation is faster with a larger exposed surface area, higher temperature and more wind." },
			{ id = "PS-MW-04", topic = "Matter and Water", quick = true, q = "How are clouds formed?", o = { "Water vapour rises, loses heat and condenses into tiny water droplets.", "Water in the sea boils and rises into the sky.", "Smoke from factories collects in the sky.", "Rain droplets freeze high in the sky." }, a = 1, x = "Warm water vapour rises, cools as it loses heat, and condenses into tiny water droplets that form clouds." },
			{ id = "PS-MW-05", topic = "Matter and Water", quick = true, q = "A ball becomes heavier after more air is pumped into it. What does this show?", o = { "Air has mass.", "Air takes the shape of its container.", "Air can be compressed.", "Air is a mixture of gases." }, a = 1, x = "The extra mass comes from the air pumped in, so air has mass." },
			{ id = "PS-PS-01", topic = "Plant Systems", quick = true, q = "Which part of a plant carries water from the roots to the leaves?", o = { "food-carrying tubes", "water-carrying tubes", "stomata", "root hairs" }, a = 2, x = "Water-carrying tubes transport water and mineral salts up from the roots. Food-carrying tubes carry food made in the leaves to other parts." },
			{ id = "PS-PS-02", topic = "Plant Systems", quick = true, q = "A ring of bark, including the food-carrying tubes, is removed from a tree's stem. After a few weeks the stem just above the ring swells. Why?", o = { "Water collects above the ring.", "Food made in the leaves cannot move down past the ring.", "The roots cannot absorb water.", "The leaves stop making food." }, a = 2, x = "The food-carrying tubes were removed, so food moving down from the leaves builds up just above the ring and the stem swells there." },
			{ id = "PS-HS-01", topic = "Human Systems", quick = true, q = "In which part of the digestive system is digestion completed?", o = { "stomach", "small intestine", "large intestine", "gullet" }, a = 2, x = "Digestion is completed in the small intestine, where digested food is also absorbed into the blood." },
			{ id = "PS-HS-02", topic = "Human Systems", quick = true, q = "What is the main function of the lungs?", o = { "to pump blood around the body", "to take in oxygen and remove carbon dioxide", "to digest food", "to remove water from the blood" }, a = 2, x = "In the lungs, oxygen passes into the blood and carbon dioxide is removed. The heart pumps blood." },
			{ id = "PS-HS-03", topic = "Human Systems", quick = true, q = "In which of these parts does NO digestion of food take place?", o = { "mouth", "stomach", "small intestine", "gullet" }, a = 4, x = "The gullet only moves food from the mouth to the stomach. Digestion happens in the mouth, stomach and small intestine." },
			{ id = "PS-CEL-01", topic = "Cells", quick = true, q = "Which parts are found in a plant cell but NOT in an animal cell?", o = { "cell wall and chloroplasts", "nucleus and cytoplasm", "cell membrane and nucleus", "cytoplasm and cell membrane" }, a = 1, x = "Plant cells have a cell wall for shape and chloroplasts for photosynthesis. Both cell types have a nucleus, cytoplasm and cell membrane." },
			{ id = "PS-CEL-02", topic = "Cells", quick = true, q = "Which part of a cell controls all its activities?", o = { "nucleus", "cytoplasm", "cell membrane", "cell wall" }, a = 1, x = "The nucleus controls the activities of the cell. The cell membrane controls what enters and leaves." },
			{ id = "PS-ES-02", topic = "Electrical Systems", quick = true, q = "Which object, placed across a gap in a circuit, will make the bulb light up?", o = { "steel paper clip", "rubber band", "plastic ruler", "wooden chopstick" }, a = 1, x = "Steel is a metal, which is an electrical conductor. Rubber, plastic and wood are insulators." },
			{ id = "PS-ES-03", topic = "Electrical Systems", quick = true, q = "Two bulbs are connected in series to a battery. One bulb fuses. What happens to the other bulb?", o = { "It gets brighter.", "It stays the same.", "It goes out, because the circuit is broken.", "It flickers." }, a = 3, x = "In series there is only one path for the current. A fused bulb breaks that path, so no current flows and the other bulb goes out." },
			{ id = "PS-LT-01", topic = "Light", quick = true, q = "Why can we see a book in a lit room?", o = { "Light from the book's own glow enters our eyes.", "Light reflected off the book enters our eyes.", "Light from our eyes falls on the book.", "The book absorbs all the light." }, a = 2, x = "A book is not a light source. Light from a lamp or the sun reflects off the book and enters our eyes." },
			{ id = "PS-HT-01", topic = "Heat", quick = true, q = "A metal spoon placed in hot soup becomes hot. Why?", o = { "Heat flows from the soup to the spoon.", "Cold flows from the spoon to the soup.", "The spoon produces heat.", "Heat flows from the spoon to the soup." }, a = 1, x = "Heat always flows from a hotter object to a colder one, here from the soup into the spoon. There is no such thing as cold flowing." },
			{ id = "PS-HT-02", topic = "Heat", quick = true, q = "Why are small gaps left between sections of a railway track?", o = { "to save metal", "to let rainwater drain away", "to allow the metal to expand when it gains heat", "to make the train run more quietly" }, a = 3, x = "Metal expands when it gains heat. Without gaps, the rails would push against each other and bend on hot days." },
			{ id = "PS-HT-03", topic = "Heat", quick = true, q = "A dented ping-pong ball regains its shape when placed in hot water. Why?", o = { "The water enters the ball.", "The air inside the ball gains heat and expands.", "The plastic shrinks in hot water.", "The air inside loses heat and contracts." }, a = 2, x = "Air inside the ball gains heat from the hot water and expands, pushing the dent out." },
			{ id = "PS-EC-01", topic = "Energy Conversion", quick = true, q = "Which are needed for photosynthesis?", o = { "water, carbon dioxide and light", "water, oxygen and light", "oxygen, carbon dioxide and food", "food, water and light" }, a = 1, x = "Plants use light energy, water and carbon dioxide to make food (sugar), giving off oxygen. Oxygen is a product, not a need." },
			{ id = "PS-EC-02", topic = "Energy Conversion", quick = true, q = "What are the energy conversions in a battery-powered torch?", o = { "chemical potential → electrical → light and heat", "electrical → chemical potential → light", "light → electrical → heat", "kinetic → electrical → light" }, a = 1, x = "The battery's chemical potential energy becomes electrical energy, which the bulb converts into light and heat." },
			{ id = "PS-EC-03", topic = "Energy Conversion", quick = true, q = "A ball is dropped and bounces. Each bounce is lower than the last. Why?", o = { "Energy is destroyed at each bounce.", "Some energy is converted into heat and sound at each bounce.", "Gravity becomes stronger.", "The ball loses mass." }, a = 2, x = "Energy cannot be destroyed. Some is converted to heat and sound at each bounce, so less is left to lift the ball." },
			{ id = "PS-MG-01", topic = "Magnets", quick = true, q = "Which object will a magnet attract?", o = { "aluminium can", "copper wire", "iron nail", "plastic spoon" }, a = 3, x = "Magnets attract magnetic materials such as iron, steel, nickel and cobalt. Aluminium and copper are metals but not magnetic." },
			{ id = "PS-MG-02", topic = "Magnets", quick = true, q = "The north pole of one magnet is brought near the north pole of another. What happens?", o = { "They attract.", "They repel.", "Nothing happens.", "Both become non-magnetic." }, a = 2, x = "Like poles repel and unlike poles attract." },
			{ id = "PS-MG-03", topic = "Magnets", quick = true, q = "Which change makes an electromagnet stronger?", o = { "using fewer coils of wire", "using more coils of wire", "using a plastic core", "using fewer batteries" }, a = 2, x = "More coils of wire (or more batteries) makes an electromagnet stronger. An iron core helps too. Plastic does not." },
			{ id = "PS-FO-02", topic = "Forces", quick = true, q = "Why do hiking shoes have soles with deep grooves?", o = { "to reduce friction", "to increase friction", "to make the shoes lighter", "to reduce gravity" }, a = 2, x = "Deep grooves increase friction between the shoe and the ground, so the hiker is less likely to slip." },
			{ id = "PS-FO-03", topic = "Forces", quick = true, q = "Which force makes an apple fall from a tree?", o = { "magnetic force", "frictional force", "gravitational force", "elastic spring force" }, a = 3, x = "Gravitational force is the pull of the Earth on objects. It pulls the apple down." },
			{ id = "PS-ENV-02", topic = "Environment", quick = true, q = "A cactus has spines instead of broad leaves. How does this help it survive in the desert?", o = { "It reduces water loss.", "It makes more food.", "It attracts insects.", "It absorbs more sunlight." }, a = 1, x = "Spines have a much smaller surface area than leaves, so less water is lost. They also protect the cactus from animals." },
			{ id = "PS-ENV-03", topic = "Environment", quick = true, q = "Which is a direct result of clearing large areas of forest?", o = { "Animals lose their habitats.", "There is more oxygen in the air.", "There is less carbon dioxide in the air.", "There are more food sources for animals." }, a = 1, x = "Clearing forests destroys the homes of many organisms. It also leaves fewer trees to take in carbon dioxide." },
			{ id = "PS-ENV-04", topic = "Environment", quick = true, q = "What is the role of decomposers such as fungi and bacteria?", o = { "They break down dead matter and return nutrients to the soil.", "They make food using sunlight.", "They eat only living plants.", "They pollinate flowers." }, a = 1, x = "Decomposers break down dead plants and animals, returning nutrients to the soil for plants to use." },
		},
	},
	math = {
		name = "PSLE Maths",
		constants = "",
		questions = {
			{ id = "PM-WN-01", topic = "Whole Numbers", quick = true, q = "In 470 582, which digit is in the thousands place?", o = { "4", "7", "0", "5" }, a = 3, x = "470 582 = 4 hundred thousands, 7 ten thousands, 0 thousands, 5 hundreds, 8 tens, 2 ones." },
			{ id = "PM-WN-02", topic = "Whole Numbers", quick = true, q = "Round 64 950 to the nearest thousand.", o = { "64 000", "64 900", "65 000", "70 000" }, a = 3, x = "The hundreds digit is 9 (5 or more), so round up: 64 950 → 65 000." },
			{ id = "PM-WN-03", topic = "Whole Numbers", quick = true, q = "Find the value of 8 + 12 ÷ 4 × 2.", o = { "9.5", "10", "14", "40" }, a = 3, x = "Divide and multiply from left to right before adding: 12 ÷ 4 = 3, 3 × 2 = 6, then 8 + 6 = 14." },
			{ id = "PM-WN-04", topic = "Whole Numbers", quick = true, q = "What is the smallest number that is a multiple of both 6 and 8?", o = { "2", "14", "24", "48" }, a = 3, x = "Multiples of 8: 8, 16, 24… The first one that is also a multiple of 6 is 24." },
			{ id = "PM-FR-01", topic = "Fractions", quick = true, q = "Find the value of 3/4 − 1/6.", o = { "1/2", "5/12", "7/12", "2/10" }, a = 3, x = "Use twelfths: 9/12 − 2/12 = 7/12." },
			{ id = "PM-FR-02", topic = "Fractions", quick = true, q = "What is 2/5 of 45?", o = { "9", "18", "27", "36" }, a = 2, x = "1/5 of 45 is 9, so 2/5 is 18." },
			{ id = "PM-FR-03", topic = "Fractions", quick = true, q = "Find the value of 3 ÷ 1/4.", o = { "3/4", "4/3", "7", "12" }, a = 4, x = "Dividing by 1/4 is the same as multiplying by 4: 3 × 4 = 12. There are 12 quarters in 3." },
			{ id = "PM-FR-04", topic = "Fractions", quick = true, q = "Which fraction is the largest?", o = { "5/8", "2/3", "3/5", "7/12" }, a = 2, x = "Over 120: 5/8 = 75/120, 2/3 = 80/120, 3/5 = 72/120, 7/12 = 70/120. 2/3 is the largest." },
			{ id = "PM-DE-01", topic = "Decimals", quick = true, q = "Find the value of 0.4 × 0.3.", o = { "0.012", "0.12", "1.2", "0.7" }, a = 2, x = "4 × 3 = 12, and there are two decimal places in total, so 0.12." },
			{ id = "PM-DE-02", topic = "Decimals", quick = true, q = "Find the value of 3.6 ÷ 0.06.", o = { "0.6", "6", "60", "600" }, a = 3, x = "Multiply both by 100: 360 ÷ 6 = 60." },
			{ id = "PM-DE-03", topic = "Decimals", quick = true, q = "Express 2 7/20 as a decimal.", o = { "2.14", "2.35", "2.7", "2.72" }, a = 2, x = "7/20 = 35/100 = 0.35, so 2 7/20 = 2.35." },
			{ id = "PM-PC-01", topic = "Percentage", quick = true, q = "What is 15% of 80?", o = { "1.2", "5.3", "12", "65" }, a = 3, x = "10% of 80 is 8 and 5% is 4, so 15% is 12." },
			{ id = "PM-PC-02", topic = "Percentage", quick = true, q = "A bag costs $60 after a 25% discount. What was its original price?", o = { "$45", "$75", "$80", "$85" }, a = 3, x = "$60 is 75% of the original price. 25% is $20, so 100% is $80." },
			{ id = "PM-PC-03", topic = "Percentage", quick = true, q = "A 9% tax is added to a $200 item. What is the total price?", o = { "$180", "$209", "$218", "$290" }, a = 3, x = "9% of $200 is $18, so the total is $218." },
			{ id = "PM-PC-04", topic = "Percentage", quick = true, q = "The number of pupils in a club rose from 40 to 50. What is the percentage increase?", o = { "10%", "20%", "25%", "80%" }, a = 3, x = "The increase of 10 is compared with the original 40: 10/40 = 1/4 = 25%." },
			{ id = "PM-RA-01", topic = "Ratio", quick = true, q = "Ali and Ben share $90 in the ratio 2 : 3. How much does Ben get?", o = { "$18", "$36", "$45", "$54" }, a = 4, x = "There are 5 units in total, so 1 unit = $18. Ben gets 3 units = $54." },
			{ id = "PM-RA-02", topic = "Ratio", quick = true, q = "The ratio of boys to girls in a hall is 3 : 5. There are 30 girls. How many boys are there?", o = { "15", "18", "48", "50" }, a = 2, x = "5 units = 30, so 1 unit = 6 and the boys are 3 units = 18." },
			{ id = "PM-RA-03", topic = "Ratio", quick = true, q = "Express 12 : 18 : 30 in its simplest form.", o = { "2 : 3 : 5", "4 : 6 : 10", "6 : 9 : 15", "1 : 2 : 3" }, a = 1, x = "Divide each term by the highest common factor, 6: 2 : 3 : 5." },
			{ id = "PM-AL-01", topic = "Algebra", quick = true, q = "Find the value of 3y − 5 when y = 4.", o = { "2", "7", "12", "17" }, a = 2, x = "3 × 4 − 5 = 12 − 5 = 7." },
			{ id = "PM-AL-02", topic = "Algebra", quick = true, q = "Simplify 5a + 3 − 2a + 4.", o = { "3a + 7", "7a + 7", "3a − 1", "10a" }, a = 1, x = "Group like terms: 5a − 2a = 3a and 3 + 4 = 7." },
			{ id = "PM-AL-03", topic = "Algebra", quick = true, q = "Pens cost $k each. Mary buys 6 pens and pays with a $20 note. How much change does she get, in dollars?", o = { "6k − 20", "20 − 6k", "20 − k", "26k" }, a = 2, x = "The 6 pens cost 6k dollars, so the change is 20 − 6k." },
			{ id = "PM-AP-02", topic = "Area and Perimeter", quick = true, q = "A square has a perimeter of 36 cm. What is its area?", o = { "9 cm²", "36 cm²", "81 cm²", "144 cm²" }, a = 3, x = "Each side is 36 ÷ 4 = 9 cm, so the area is 9 × 9 = 81 cm²." },
			{ id = "PM-AP-04", topic = "Area and Perimeter", quick = true, q = "A triangle has a base of 12 cm and a height of 5 cm. What is its area?", o = { "17 cm²", "30 cm²", "34 cm²", "60 cm²" }, a = 2, x = "Area = ½ × base × height = ½ × 12 × 5 = 30 cm²." },
			{ id = "PM-VO-02", topic = "Volume", quick = true, q = "A tank measures 50 cm by 40 cm by 30 cm. It is filled with water to 3/4 of its height. How much water is in the tank? (1 ℓ = 1000 cm³)", o = { "15 ℓ", "45 ℓ", "60 ℓ", "450 ℓ" }, a = 2, x = "The water is 3/4 × 30 = 22.5 cm deep. Volume = 50 × 40 × 22.5 = 45 000 cm³ = 45 ℓ." },
			{ id = "PM-VO-03", topic = "Volume", quick = true, q = "A cube has a volume of 64 cm³. What is the length of one edge?", o = { "4 cm", "8 cm", "16 cm", "21 cm" }, a = 1, x = "4 × 4 × 4 = 64, so each edge is 4 cm." },
			{ id = "PM-AG-03", topic = "Angles and Geometry", quick = true, q = "One angle of a parallelogram is 65°. What is the size of an angle next to it?", o = { "25°", "65°", "115°", "295°" }, a = 3, x = "Adjacent angles in a parallelogram add up to 180°: 180° − 65° = 115°." },
			{ id = "PM-AG-04", topic = "Angles and Geometry", quick = true, q = "Which shape always has exactly one pair of parallel sides?", o = { "rhombus", "trapezium", "rectangle", "parallelogram" }, a = 2, x = "A trapezium has exactly one pair of parallel sides. The other three have two pairs." },
			{ id = "PM-SP-01", topic = "Speed", quick = true, q = "A car travels 150 km in 2.5 hours. What is its average speed?", o = { "37.5 km/h", "60 km/h", "75 km/h", "375 km/h" }, a = 2, x = "Speed = distance ÷ time = 150 ÷ 2.5 = 60 km/h." },
			{ id = "PM-SP-02", topic = "Speed", quick = true, q = "Siti walks at 5 km/h for 1 hour 12 minutes. How far does she walk?", o = { "5.6 km", "6 km", "6.2 km", "7.2 km" }, a = 2, x = "1 h 12 min = 1.2 h (12 min = 0.2 h). Distance = 5 × 1.2 = 6 km." },
			{ id = "PM-SP-03", topic = "Speed", quick = true, q = "Express 72 km/h in metres per second.", o = { "2 m/s", "20 m/s", "72 m/s", "200 m/s" }, a = 2, x = "72 km/h = 72 000 m in 3600 s = 20 m/s." },
			{ id = "PM-AV-01", topic = "Average", quick = true, q = "Find the average of 12, 15, 18 and 23.", o = { "15", "16.5", "17", "18" }, a = 3, x = "Total = 68, and 68 ÷ 4 = 17." },
			{ id = "PM-AV-02", topic = "Average", quick = true, q = "The average of 4 numbers is 25. When a fifth number is added, the average becomes 28. What is the fifth number?", o = { "3", "28", "33", "40" }, a = 4, x = "The total goes from 4 × 25 = 100 to 5 × 28 = 140, so the fifth number is 40." },
		},
	},
	chem = {
		name = "H2 Chemistry",
		constants = "Avogadro constant L = 6.02 × 10²³ mol⁻¹ · Faraday constant F = 9.65 × 10⁴ C mol⁻¹ · Gas constant R = 8.31 J K⁻¹ mol⁻¹ · Molar volume of gas at r.t.p. = 24.0 dm³ mol⁻¹ · Kw = 1.00 × 10⁻¹⁴ mol² dm⁻⁶ at 298 K · Specific heat capacity of water = 4.18 J g⁻¹ K⁻¹ · 0 °C = 273 K",
		questions = {
			{ id = "HC-ATM-01", topic = "Atomic Structure", quick = true, q = "How many neutrons are in one ³⁷Cl⁻ ion? (proton number of Cl = 17)", o = { "17", "18", "20", "37" }, a = 3, x = "Neutrons = nucleon number − proton number = 37 − 17 = 20. The extra electron changes the electron count (18), not the neutron count." },
			{ id = "HC-ATM-02", topic = "Atomic Structure", quick = true, q = "What is the electronic configuration of Fe³⁺? (proton number of Fe = 26)", o = { "[Ar] 3d⁵", "[Ar] 3d³ 4s²", "[Ar] 3d⁶", "[Ar] 3d⁴ 4s¹" }, a = 1, x = "Fe is [Ar] 3d⁶ 4s². The 4s electrons are lost first, then one 3d electron, leaving [Ar] 3d⁵." },
			{ id = "HC-ATM-03", topic = "Atomic Structure", quick = false, q = "Which Period 3 element has a lower first ionisation energy than the element just before it?", o = { "Al", "Si", "P", "Cl" }, a = 1, x = "Al's outermost electron is in a 3p orbital, higher in energy and better shielded by the 3s² electrons than Mg's 3s electron, so it is easier to remove. (S is the other exception, because of paired-electron repulsion in 3p⁴.)" },
			{ id = "HC-ATM-04", topic = "Atomic Structure", quick = false, q = "The first five ionisation energies of element X are 578, 1817, 2745, 11577 and 14842 kJ mol⁻¹. Which group is X in?", o = { "Group 2", "Group 13", "Group 14", "Group 15" }, a = 2, x = "The large jump is between the 3rd and 4th ionisation energies, so X has 3 valence electrons and the 4th comes from an inner shell. X is in Group 13 (these are aluminium's values)." },
			{ id = "HC-ATM-05", topic = "Atomic Structure", quick = false, q = "A beam of ¹H⁺ ions is deflected by +8° in an electric field. Under the same conditions, what is the angle of deflection of ⁶Li³⁺ ions?", o = { "+4°", "+1.3°", "+16°", "−4°" }, a = 1, x = "Deflection is proportional to charge/mass. For ¹H⁺, q/m = 1/1; for ⁶Li³⁺, q/m = 3/6 = 1/2. So the angle is ½ × 8° = +4°, in the same direction because both are positive." },
			{ id = "HC-BND-01", topic = "Chemical Bonding", quick = true, q = "What is the shape of an NH₃ molecule?", o = { "trigonal planar", "trigonal pyramidal", "tetrahedral", "bent" }, a = 2, x = "N has 3 bond pairs and 1 lone pair. The four electron pairs are arranged tetrahedrally, but the shape (atoms only) is trigonal pyramidal." },
			{ id = "HC-BND-02", topic = "Chemical Bonding", quick = true, q = "Which molecule is polar?", o = { "CO₂", "BF₃", "CCl₄", "PCl₃" }, a = 4, x = "PCl₃ is trigonal pyramidal (one lone pair on P), so the bond dipoles don't cancel. CO₂ (linear), BF₃ (trigonal planar) and CCl₄ (tetrahedral) are symmetrical, so their dipoles cancel." },
			{ id = "HC-BND-03", topic = "Chemical Bonding", quick = false, q = "Why does HF have a much higher boiling point than HCl?", o = { "HF molecules form hydrogen bonds with each other.", "The H–F bond is stronger than the H–Cl bond.", "HF has more electrons, so its instantaneous dipole–induced dipole forces are stronger.", "HF is an ionic compound." }, a = 1, x = "Boiling separates molecules; it doesn't break covalent bonds. F is small and highly electronegative, so HF forms strong hydrogen bonds between molecules. HCl actually has more electrons than HF, so dispersion forces alone would predict the opposite order." },
			{ id = "HC-BND-04", topic = "Chemical Bonding", quick = false, q = "What is the shape of the ICl₄⁻ ion?", o = { "tetrahedral", "square planar", "see-saw", "square pyramidal" }, a = 2, x = "I has 7 valence electrons + 1 for the negative charge = 8. Four are used in I–Cl bonds, leaving 2 lone pairs: 6 electron pairs in total, arranged octahedrally. With the lone pairs opposite each other, the shape is square planar." },
			{ id = "HC-BND-05", topic = "Chemical Bonding", quick = false, q = "Which species has the largest bond angle?", o = { "NH₄⁺", "NH₃", "NH₂⁻", "NO₂⁺" }, a = 4, x = "NO₂⁺ (O=N⁺=O) has two bonding regions and no lone pairs on N, so it is linear, 180°. NH₄⁺ is 109.5°, NH₃ about 107° (1 lone pair) and NH₂⁻ about 104.5° (2 lone pairs)." },
			{ id = "HC-GAS-01", topic = "The Gaseous State", quick = true, q = "Which is NOT an assumption of the kinetic theory for an ideal gas?", o = { "All the gas molecules move at the same speed.", "The volume of the molecules is negligible compared with the volume of the container.", "There are no intermolecular forces between the molecules.", "Collisions between molecules are perfectly elastic." }, a = 1, x = "Molecules in an ideal gas have a distribution of speeds (the Maxwell–Boltzmann distribution). Negligible molecular volume, no intermolecular forces and elastic collisions are all assumptions." },
			{ id = "HC-GAS-02", topic = "The Gaseous State", quick = true, q = "Under which conditions does a real gas behave most like an ideal gas?", o = { "high temperature and low pressure", "low temperature and high pressure", "high temperature and high pressure", "low temperature and low pressure" }, a = 1, x = "At low pressure the molecules are far apart, so their own volume is negligible. At high temperature they move fast enough that intermolecular attractions hardly matter." },
			{ id = "HC-GAS-03", topic = "The Gaseous State", quick = true, q = "Which gas deviates most from ideal behaviour at room temperature and pressure?", o = { "He", "H₂", "N₂", "NH₃" }, a = 4, x = "NH₃ molecules form hydrogen bonds with each other, so intermolecular attractions are much stronger than in He, H₂ or N₂, which have only weak instantaneous dipole–induced dipole forces." },
			{ id = "HC-GAS-05", topic = "The Gaseous State", quick = false, q = "0.50 g of a volatile liquid is vaporised and occupies 150 cm³ at 100 °C and 101 kPa. What is its relative molecular mass?", o = { "102", "27", "51", "0.10" }, a = 1, x = "n = pV/RT = (101 000 × 150 × 10⁻⁶) / (8.31 × 373) = 4.89 × 10⁻³ mol, so Mr = 0.50 / 4.89 × 10⁻³ ≈ 102. Using 100 instead of 373 K gives 27." },
			{ id = "HC-MOL-01", topic = "Mole Concept", quick = true, q = "How many moles of NaOH are in 4.0 g of NaOH? (Mr = 40)", o = { "0.10", "1.0", "10", "0.40" }, a = 1, x = "n = mass / Mr = 4.0 / 40 = 0.10 mol." },
			{ id = "HC-MOL-02", topic = "Mole Concept", quick = true, q = "10.0 g of CaCO₃ (Mr = 100) reacts with excess dilute HCl. What volume of CO₂ is produced at r.t.p.?", o = { "1.2 dm³", "2.4 dm³", "4.8 dm³", "24 dm³" }, a = 2, x = "CaCO₃ + 2HCl → CaCl₂ + H₂O + CO₂. 0.100 mol CaCO₃ gives 0.100 mol CO₂, and 0.100 × 24.0 = 2.4 dm³." },
			{ id = "HC-MOL-03", topic = "Mole Concept", quick = false, q = "25.0 cm³ of aqueous Na₂CO₃ needs 20.0 cm³ of 0.100 mol dm⁻³ HCl for complete reaction to CO₂. What is the concentration of the Na₂CO₃?", o = { "0.0400 mol dm⁻³", "0.0800 mol dm⁻³", "0.0200 mol dm⁻³", "0.125 mol dm⁻³" }, a = 1, x = "Na₂CO₃ + 2HCl → 2NaCl + H₂O + CO₂. n(HCl) = 2.00 × 10⁻³ mol, so n(Na₂CO₃) = 1.00 × 10⁻³ mol, and 1.00 × 10⁻³ / 0.0250 = 0.0400 mol dm⁻³. Forgetting the 1 : 2 ratio gives 0.0800." },
			{ id = "HC-MOL-04", topic = "Mole Concept", quick = false, q = "25.0 cm³ of an acidified Fe²⁺ solution reacts exactly with 20.0 cm³ of 0.0200 mol dm⁻³ KMnO₄. What is the concentration of Fe²⁺? (MnO₄⁻ + 8H⁺ + 5Fe²⁺ → Mn²⁺ + 5Fe³⁺ + 4H₂O)", o = { "0.0800 mol dm⁻³", "0.0160 mol dm⁻³", "0.00320 mol dm⁻³", "0.400 mol dm⁻³" }, a = 1, x = "n(MnO₄⁻) = 0.0200 × 0.0200 = 4.00 × 10⁻⁴ mol, so n(Fe²⁺) = 5 × 4.00 × 10⁻⁴ = 2.00 × 10⁻³ mol. [Fe²⁺] = 2.00 × 10⁻³ / 0.0250 = 0.0800 mol dm⁻³." },
			{ id = "HC-MOL-05", topic = "Mole Concept", quick = false, q = "10 cm³ of a gaseous hydrocarbon is burned in excess oxygen. On cooling to room temperature the volume decreases by 25 cm³. Passing the remaining gas through aqueous KOH decreases the volume by a further 30 cm³. What is the hydrocarbon?", o = { "C₃H₄", "C₃H₆", "C₃H₈", "C₂H₆" }, a = 2, x = "CO₂ absorbed by KOH = 30 cm³, so x = 3. For CₓHᵧ + (x + y/4)O₂ → xCO₂ + (y/2)H₂O(l), the contraction is 10(1 + y/4) = 25, so y = 6. The hydrocarbon is C₃H₆." },
			{ id = "HC-ENG-01", topic = "Chemical Energetics", quick = true, q = "Which substance has a standard enthalpy change of formation of zero?", o = { "O₂(g)", "O₃(g)", "H₂O(l)", "C(diamond)" }, a = 1, x = "ΔHf° is zero only for an element in its standard state. Oxygen's standard state is O₂(g); carbon's is graphite, not diamond. O₃ and H₂O are not standard-state elements." },
			{ id = "HC-ENG-02", topic = "Chemical Energetics", quick = false, q = "When 0.0250 mol of an acid is neutralised in 50.0 g of water, the temperature rises by 6.0 K. What is the enthalpy change of neutralisation?", o = { "−50.2 kJ mol⁻¹", "+50.2 kJ mol⁻¹", "−1.25 kJ mol⁻¹", "−5.02 kJ mol⁻¹" }, a = 1, x = "q = mcΔT = 50.0 × 4.18 × 6.0 = 1254 J. ΔH = −1254 / 0.0250 = −50 200 J mol⁻¹ = −50.2 kJ mol⁻¹. It is negative because the temperature rose (exothermic)." },
			{ id = "HC-ENG-03", topic = "Chemical Energetics", quick = false, q = "Use these standard enthalpy changes of combustion to find ΔHf° of methane: C(graphite) −394, H₂(g) −286, CH₄(g) −890 kJ mol⁻¹.", o = { "−76 kJ mol⁻¹", "+76 kJ mol⁻¹", "+210 kJ mol⁻¹", "−1856 kJ mol⁻¹" }, a = 1, x = "ΔHf = ΣΔHc(reactants) − ΣΔHc(products) = [−394 + 2(−286)] − (−890) = −966 + 890 = −76 kJ mol⁻¹. Forgetting the 2 for H₂ gives +210." },
			{ id = "HC-ENG-04", topic = "Chemical Energetics", quick = true, q = "Bond energies: H–H 436, Cl–Cl 242, H–Cl 431 kJ mol⁻¹. What is ΔH for H₂(g) + Cl₂(g) → 2HCl(g)?", o = { "−184 kJ mol⁻¹", "+184 kJ mol⁻¹", "+247 kJ mol⁻¹", "−862 kJ mol⁻¹" }, a = 1, x = "ΔH = bonds broken − bonds formed = (436 + 242) − 2(431) = 678 − 862 = −184 kJ mol⁻¹." },
			{ id = "HC-ENG-05", topic = "Chemical Energetics", quick = false, q = "For CaCO₃(s) → CaO(s) + CO₂(g), ΔH° = +178 kJ mol⁻¹ and ΔS° = +161 J K⁻¹ mol⁻¹. Above what temperature does the reaction become spontaneous?", o = { "1106 K", "1.11 K", "833 K", "298 K" }, a = 1, x = "Spontaneous when ΔG = ΔH − TΔS < 0, i.e. T > ΔH/ΔS = 178 000 / 161 = 1106 K. Not converting kJ to J gives 1.11 K." },
			{ id = "HC-ENG-06", topic = "Chemical Energetics", quick = true, q = "Which compound has the most exothermic lattice energy?", o = { "MgO", "NaCl", "KBr", "MgCl₂" }, a = 1, x = "Lattice energy is proportional to (q⁺ × q⁻)/(r⁺ + r⁻). MgO has 2+ and 2− ions that are both small, so its lattice energy is far more exothermic than the others." },
			{ id = "HC-KIN-01", topic = "Reaction Kinetics", quick = true, q = "How does a catalyst increase the rate of a reaction?", o = { "It provides an alternative pathway with a lower activation energy.", "It makes the reaction more exothermic.", "It increases the kinetic energy of the particles.", "It shifts the position of equilibrium to the right." }, a = 1, x = "A catalyst offers a different route with lower Ea, so more collisions have enough energy to react. ΔH, particle energies and the equilibrium position are unchanged." },
			{ id = "HC-KIN-02", topic = "Reaction Kinetics", quick = false, q = "The rate equation is rate = k[A][B]², with concentrations in mol dm⁻³ and rate in mol dm⁻³ s⁻¹. What are the units of k?", o = { "mol⁻² dm⁶ s⁻¹", "mol² dm⁻⁶ s⁻¹", "mol⁻¹ dm³ s⁻¹", "s⁻¹" }, a = 1, x = "k = rate / ([A][B]²) = (mol dm⁻³ s⁻¹) / (mol dm⁻³)³ = mol⁻² dm⁶ s⁻¹. A third-order reaction always has these units." },
			{ id = "HC-KIN-03", topic = "Reaction Kinetics", quick = false, q = "Initial rates for A + B → products: [A] 0.10, [B] 0.10 gives rate r; [A] 0.20, [B] 0.10 gives 4r; [A] 0.10, [B] 0.30 gives 3r. What is the rate equation?", o = { "rate = k[A]²[B]", "rate = k[A][B]", "rate = k[A]²[B]²", "rate = k[A][B]³" }, a = 1, x = "Doubling [A] quadruples the rate, so second order in A. Tripling [B] triples the rate, so first order in B. Rate = k[A]²[B]." },
			{ id = "HC-KIN-05", topic = "Reaction Kinetics", quick = false, q = "For (CH₃)₃CBr + OH⁻ → (CH₃)₃COH + Br⁻, rate = k[(CH₃)₃CBr]. Which statement is correct?", o = { "Doubling both concentrations doubles the rate.", "Doubling [OH⁻] doubles the rate.", "OH⁻ takes part in the rate-determining step.", "The reaction is second order overall." }, a = 1, x = "The rate depends only on [(CH₃)₃CBr], so doubling both doubles the rate. OH⁻ does not appear in the rate equation, so it reacts after the slow step (SN1) and the reaction is first order overall." },
			{ id = "HC-KIN-06", topic = "Reaction Kinetics", quick = false, q = "Propanone reacts with iodine in acid, with propanone and H⁺ in large excess. A graph of [I₂] against time is a straight line sloping down. What is the order with respect to I₂?", o = { "zero", "first", "second", "It cannot be found from this graph." }, a = 1, x = "A straight line on a concentration–time graph means the rate (the gradient) stays constant as [I₂] falls, so the rate doesn't depend on [I₂]: zero order. Excess propanone and H⁺ keep their concentrations effectively constant." },
			{ id = "HC-EQM-01", topic = "Chemical Equilibria", quick = true, q = "N₂(g) + 3H₂(g) ⇌ 2NH₃(g), ΔH = −92 kJ mol⁻¹. Which change increases the equilibrium yield of NH₃?", o = { "increasing the pressure", "increasing the temperature", "adding an iron catalyst", "removing some N₂" }, a = 1, x = "Higher pressure favours the side with fewer gas moles (2 vs 4), so the yield rises. Higher temperature favours the endothermic backward reaction; a catalyst doesn't move the equilibrium." },
			{ id = "HC-EQM-02", topic = "Chemical Equilibria", quick = true, q = "What are the units of Kc for N₂(g) + 3H₂(g) ⇌ 2NH₃(g)?", o = { "mol⁻² dm⁶", "mol² dm⁻⁶", "mol⁻¹ dm³", "no units" }, a = 1, x = "Kc = [NH₃]² / ([N₂][H₂]³), so the units are (mol dm⁻³)² / (mol dm⁻³)⁴ = (mol dm⁻³)⁻² = mol⁻² dm⁶." },
			{ id = "HC-EQM-03", topic = "Chemical Equilibria", quick = false, q = "1.0 mol H₂ and 1.0 mol I₂ are heated in a 1.0 dm³ flask. At equilibrium there is 1.6 mol HI. What is Kc for H₂ + I₂ ⇌ 2HI?", o = { "64", "40", "8.0", "0.016" }, a = 1, x = "Forming 1.6 mol HI uses 0.8 mol each of H₂ and I₂, leaving 0.2 mol of each. Kc = 1.6² / (0.2 × 0.2) = 2.56 / 0.04 = 64. Forgetting to square [HI] gives 40." },
			{ id = "HC-EQM-04", topic = "Chemical Equilibria", quick = false, q = "N₂O₄(g) ⇌ 2NO₂(g). At a total pressure of 1.0 atm, N₂O₄ is 50% dissociated. What is Kp?", o = { "1.33 atm", "2.0 atm", "0.44 atm", "0.67 atm" }, a = 1, x = "From 1 mol N₂O₄: 0.5 mol N₂O₄ and 1.0 mol NO₂, 1.5 mol total. Partial pressures are 1/3 atm and 2/3 atm. Kp = (2/3)² / (1/3) = 4/3 = 1.33 atm. Using moles instead of partial pressures gives 2.0." },
			{ id = "HC-EQM-05", topic = "Chemical Equilibria", quick = false, q = "The forward reaction of an equilibrium is exothermic. What happens to Kc when the temperature is raised?", o = { "Kc decreases.", "Kc increases.", "Kc stays the same.", "Kc increases at first, then returns to its original value." }, a = 1, x = "Raising the temperature favours the endothermic (backward) reaction, so the equilibrium mixture has less product and Kc falls. Only temperature changes the value of K." },
			{ id = "HC-ACB-01", topic = "Acids and Bases", quick = true, q = "What is the conjugate base of H₂PO₄⁻?", o = { "HPO₄²⁻", "H₃PO₄", "PO₄³⁻", "OH⁻" }, a = 1, x = "A conjugate base has one H⁺ fewer than its acid: H₂PO₄⁻ → HPO₄²⁻ + H⁺. H₃PO₄ is its conjugate acid." },
			{ id = "HC-ACB-03", topic = "Acids and Bases", quick = true, q = "What is the pH of 0.050 mol dm⁻³ Ba(OH)₂(aq) at 298 K?", o = { "13.0", "12.7", "1.0", "1.3" }, a = 1, x = "Each Ba(OH)₂ gives 2 OH⁻, so [OH⁻] = 0.10 mol dm⁻³ and pOH = 1.0. pH = 14.0 − 1.0 = 13.0. Forgetting the 2 gives 12.7." },
			{ id = "HC-ACB-04", topic = "Acids and Bases", quick = false, q = "What is the pH of 0.10 mol dm⁻³ ethanoic acid? (Ka = 1.8 × 10⁻⁵ mol dm⁻³)", o = { "2.87", "1.00", "4.74", "5.74" }, a = 1, x = "[H⁺] = √(Ka × c) = √(1.8 × 10⁻⁵ × 0.10) = 1.34 × 10⁻³ mol dm⁻³, so pH = 2.87. pH 1.00 treats it as a strong acid; 4.74 is pKa." },
			{ id = "HC-ACB-05", topic = "Acids and Bases", quick = false, q = "A buffer contains 0.20 mol dm⁻³ CH₃COOH and 0.10 mol dm⁻³ CH₃COONa. What is its pH? (pKa of CH₃COOH = 4.74)", o = { "4.44", "5.04", "4.74", "2.87" }, a = 1, x = "pH = pKa + log([salt]/[acid]) = 4.74 + log(0.10/0.20) = 4.74 − 0.30 = 4.44. Putting the ratio upside down gives 5.04." },
			{ id = "HC-ACB-06", topic = "Acids and Bases", quick = false, q = "25.0 cm³ of 0.10 mol dm⁻³ CH₃COOH is titrated with 0.10 mol dm⁻³ NaOH. What is the pH at the equivalence point? (Ka = 1.8 × 10⁻⁵ mol dm⁻³)", o = { "8.72", "8.87", "7.00", "5.28" }, a = 1, x = "At equivalence the total volume is 50.0 cm³, so [CH₃COO⁻] = 0.050. Kb = Kw/Ka = 5.6 × 10⁻¹⁰, [OH⁻] = √(5.6 × 10⁻¹⁰ × 0.050) = 5.3 × 10⁻⁶, pOH = 5.28, pH = 8.72. Forgetting the dilution gives 8.87." },
			{ id = "HC-ACB-07", topic = "Acids and Bases", quick = false, q = "Which indicator is most suitable for titrating ethanoic acid with sodium hydroxide?", o = { "phenolphthalein (range pH 8.3–10.0)", "methyl orange (range pH 3.1–4.4)", "methyl red (range pH 4.4–6.2)", "bromophenol blue (range pH 3.0–4.6)" }, a = 1, x = "A weak acid–strong base titration has an equivalence point above pH 7 and a steep section roughly from pH 7 to 11. Only phenolphthalein changes colour in that range." },
			{ id = "HC-ELC-01", topic = "Electrochemistry", quick = true, q = "In a galvanic (electrochemical) cell, where does oxidation take place and what is the sign of that electrode?", o = { "at the anode, which is negative", "at the anode, which is positive", "at the cathode, which is negative", "at the cathode, which is positive" }, a = 1, x = "Oxidation always happens at the anode. In a galvanic cell the anode releases electrons into the external circuit, so it is the negative electrode. (In electrolysis the anode is positive.)" },
			{ id = "HC-ELC-03", topic = "Electrochemistry", quick = false, q = "A current of 0.500 A passes through aqueous CuSO₄ for 1930 s. What mass of copper is deposited? (Ar of Cu = 63.5)", o = { "0.318 g", "0.635 g", "0.159 g", "3.18 g" }, a = 1, x = "Q = It = 0.500 × 1930 = 965 C, which is 965 / 96 500 = 0.0100 mol of electrons. Cu²⁺ + 2e⁻ → Cu, so 0.00500 mol Cu = 0.318 g. Forgetting the 2 electrons gives 0.635 g." },
			{ id = "HC-ELC-04", topic = "Electrochemistry", quick = false, q = "E°(Fe³⁺/Fe²⁺) = +0.77 V. Which species can oxidise Fe²⁺ to Fe³⁺ under standard conditions? E° values: Cl₂/Cl⁻ +1.36 V, I₂/I⁻ +0.54 V, Cu²⁺/Cu +0.34 V, Zn²⁺/Zn −0.76 V.", o = { "Cl₂", "I₂", "Cu²⁺", "Zn²⁺" }, a = 1, x = "The oxidising agent needs a more positive E° than +0.77 V so that E°cell is positive. Only Cl₂ (+1.36 V) qualifies: E°cell = 1.36 − 0.77 = +0.59 V." },
			{ id = "HC-ELC-05", topic = "Electrochemistry", quick = false, q = "In the cell Zn | Zn²⁺(aq) || Cu²⁺(aq) | Cu, the Cu²⁺ solution is diluted. What happens to the cell e.m.f.?", o = { "It decreases, because E(Cu²⁺/Cu) becomes less positive.", "It increases, because E(Cu²⁺/Cu) becomes more positive.", "It stays the same, because E° values don't depend on concentration.", "It decreases, because E(Zn²⁺/Zn) becomes more negative." }, a = 1, x = "Lowering [Cu²⁺] shifts Cu²⁺ + 2e⁻ ⇌ Cu to the left, so the copper electrode potential becomes less positive. The difference between the electrodes falls, so Ecell falls. E° is fixed but E is not." },
			{ id = "HC-ELC-06", topic = "Electrochemistry", quick = false, q = "E°cell for Zn + Cu²⁺ → Zn²⁺ + Cu is +1.10 V. What is ΔG° for this reaction?", o = { "−212 kJ mol⁻¹", "−106 kJ mol⁻¹", "+212 kJ mol⁻¹", "−0.212 kJ mol⁻¹" }, a = 1, x = "ΔG° = −nFE° = −2 × 96 500 × 1.10 = −212 300 J mol⁻¹ ≈ −212 kJ mol⁻¹. Using n = 1 gives −106." },
			{ id = "HC-PER-01", topic = "The Periodic Table", quick = true, q = "How does atomic radius change from Na to Cl across Period 3?", o = { "It decreases, because nuclear charge increases while shielding stays about the same.", "It increases, because more electrons are added.", "It decreases, because more shells are added.", "It stays about the same, because all the electrons are in the third shell." }, a = 1, x = "Across a period, protons are added but the extra electrons go into the same shell, so shielding barely changes. The rising effective nuclear charge pulls the electrons closer." },
			{ id = "HC-PER-02", topic = "The Periodic Table", quick = true, q = "Which Period 3 oxide dissolves in water to give a solution of about pH 13?", o = { "Na₂O", "MgO", "Al₂O₃", "SO₃" }, a = 1, x = "Na₂O + H₂O → 2NaOH, a strong alkali (pH about 13). MgO is only sparingly soluble (pH about 9), Al₂O₃ is insoluble, and SO₃ gives H₂SO₄ (pH about 1)." },
			{ id = "HC-PER-03", topic = "The Periodic Table", quick = true, q = "Which Period 3 oxide is amphoteric?", o = { "Al₂O₃", "MgO", "SiO₂", "P₄O₁₀" }, a = 1, x = "Al₂O₃ reacts with acids (forming Al³⁺) and with alkalis (forming [Al(OH)₄]⁻). MgO is basic; SiO₂ and P₄O₁₀ are acidic." },
			{ id = "HC-PER-04", topic = "The Periodic Table", quick = false, q = "Which Period 3 chloride dissolves in water to give a solution of pH 7?", o = { "NaCl", "AlCl₃", "SiCl₄", "PCl₅" }, a = 1, x = "NaCl simply dissolves into hydrated ions. AlCl₃ gives an acidic solution (pH about 3) because the small, highly charged Al³⁺ polarises water. SiCl₄ and PCl₅ hydrolyse completely to give HCl (pH about 1–2)." },
			{ id = "HC-PER-05", topic = "The Periodic Table", quick = false, q = "Element X is in Period 3. Its oxide has a very high melting point, is insoluble in water and doesn't react with dilute acids, but reacts with hot concentrated NaOH. Its chloride is a liquid that fumes in moist air. What is X?", o = { "Si", "Al", "Mg", "P" }, a = 1, x = "SiO₂ is giant covalent (high melting point), acidic, and reacts only with hot concentrated alkali. SiCl₄ is a simple molecular liquid that hydrolyses to give HCl fumes. Al₂O₃ would also react with dilute acid; P's oxides are low-melting." },
			{ id = "HC-TRN-01", topic = "Transition Elements", quick = true, q = "Which is NOT a typical property of transition elements?", o = { "low melting points", "variable oxidation states", "coloured compounds", "catalytic activity" }, a = 1, x = "Transition metals have high melting points because both 3d and 4s electrons take part in strong metallic bonding. Variable oxidation states, coloured ions and catalytic activity are all typical." },
			{ id = "HC-TRN-03", topic = "Transition Elements", quick = false, q = "Why is aqueous [Cu(H₂O)₆]²⁺ coloured?", o = { "Ligands split the 3d orbitals into two energy levels, and an electron absorbs visible light to move to the higher level.", "Electrons move from the 3d to the 4s orbital and emit visible light.", "The copper ion has a full 3d subshell, which reflects blue light.", "Water molecules absorb red light when they bond to the copper ion." }, a = 1, x = "In an octahedral complex the 3d orbitals split. Cu²⁺ (3d⁹) has a partly filled subshell, so a d–d transition can absorb light of energy ΔE; the colour seen is the complementary colour of what is absorbed." },
			{ id = "HC-TRN-04", topic = "Transition Elements", quick = true, q = "Which aqueous ion is colourless?", o = { "Zn²⁺", "Cu²⁺", "Fe³⁺", "Ti³⁺" }, a = 1, x = "Zn²⁺ is 3d¹⁰: the d subshell is full, so no d–d transition is possible. Cu²⁺ (3d⁹), Fe³⁺ (3d⁵) and Ti³⁺ (3d¹) all have partly filled d subshells." },
			{ id = "HC-TRN-05", topic = "Transition Elements", quick = false, q = "Adding concentrated HCl to blue aqueous Cu²⁺ gives a yellow-green solution of [CuCl₄]²⁻. How do the coordination number and shape change?", o = { "6 to 4; octahedral to tetrahedral", "6 to 4; octahedral to square planar", "4 to 6; tetrahedral to octahedral", "6 to 6; the shape stays octahedral" }, a = 1, x = "Cl⁻ ligands replace H₂O. Cl⁻ is larger than H₂O, so only four fit around Cu²⁺, and [CuCl₄]²⁻ is tetrahedral." },
			{ id = "HC-TRN-06", topic = "Transition Elements", quick = false, q = "What is the coordination number of nickel in [Ni(H₂NCH₂CH₂NH₂)₃]²⁺?", o = { "6", "3", "4", "2" }, a = 1, x = "Ethane-1,2-diamine is bidentate: each molecule bonds through both N atoms. Three ligands × 2 = 6 dative bonds, so the coordination number is 6." },
			{ id = "HC-TRN-07", topic = "Transition Elements", quick = false, q = "Fe²⁺ catalyses S₂O₈²⁻ + 2I⁻ → 2SO₄²⁻ + I₂. E° values: S₂O₈²⁻/SO₄²⁻ +2.01 V, Fe³⁺/Fe²⁺ +0.77 V, I₂/I⁻ +0.54 V. Why does it work?", o = { "S₂O₈²⁻ oxidises Fe²⁺ to Fe³⁺, then Fe³⁺ oxidises I⁻ to I₂; both steps have positive E°cell and involve oppositely charged ions.", "Fe²⁺ makes the overall reaction more exothermic.", "Fe²⁺ reduces S₂O₈²⁻ and is not regenerated, so less I⁻ is needed.", "Fe²⁺ provides a surface on which the two anions adsorb." }, a = 1, x = "Step 1: E°cell = 2.01 − 0.77 = +1.24 V. Step 2: E°cell = 0.77 − 0.54 = +0.23 V. Fe²⁺ is regenerated, and each step has a cation reacting with an anion, avoiding the repulsion that slows the uncatalysed anion–anion reaction. This is homogeneous catalysis, not surface adsorption." },
			{ id = "HC-ORG-02", topic = "Introduction to Organic Chemistry", quick = false, q = "How many structural isomers have the formula C₄H₉Br?", o = { "4", "2", "3", "5" }, a = 1, x = "1-bromobutane, 2-bromobutane, 1-bromo-2-methylpropane and 2-bromo-2-methylpropane: 4. (2-bromobutane also has enantiomers, but those are stereoisomers, not structural isomers.)" },
			{ id = "HC-ORG-03", topic = "Introduction to Organic Chemistry", quick = true, q = "Which compound shows cis–trans isomerism?", o = { "but-2-ene", "but-1-ene", "2-methylpropene", "propene" }, a = 1, x = "Each C of the C=C in but-2-ene (CH₃CH=CHCH₃) carries two different groups. In the others, one C of the double bond carries two identical groups (two H or two CH₃)." },
			{ id = "HC-ORG-04", topic = "Introduction to Organic Chemistry", quick = false, q = "How many stereoisomers does pent-3-en-2-ol, CH₃CH=CHCH(OH)CH₃, have?", o = { "4", "2", "3", "6" }, a = 1, x = "The C=C gives cis and trans forms, and C2 is a chiral centre (H, OH, CH₃, CH=CHCH₃), giving two enantiomers of each. 2 × 2 = 4." },
			{ id = "HC-ORG-05", topic = "Introduction to Organic Chemistry", quick = false, q = "How many stereoisomers does 2,3-dibromobutane, CH₃CHBrCHBrCH₃, have?", o = { "3", "4", "2", "1" }, a = 1, x = "Two chiral centres would allow 2² = 4, but the molecule is symmetrical: the (R,S) form has an internal mirror plane and is the same as (S,R). That meso form plus the (R,R)/(S,S) pair makes 3." },
			{ id = "HC-ORG-06", topic = "Introduction to Organic Chemistry", quick = true, q = "In the reaction of CN⁻ with ethanal, what role does CN⁻ play?", o = { "nucleophile", "electrophile", "free radical", "oxidising agent" }, a = 1, x = "CN⁻ donates its lone pair to the electron-deficient carbonyl carbon. It is a nucleophile, and the reaction is nucleophilic addition." },
			{ id = "HC-ALK-01", topic = "Alkanes", quick = true, q = "What type of reaction occurs between methane and chlorine in ultraviolet light?", o = { "free-radical substitution", "electrophilic addition", "nucleophilic substitution", "electrophilic substitution" }, a = 1, x = "UV light splits Cl₂ into Cl• radicals, which take an H from CH₄. A Cl atom replaces an H atom: free-radical substitution." },
			{ id = "HC-ALK-02", topic = "Alkanes", quick = true, q = "Which equation is the initiation step in the chlorination of methane?", o = { "Cl₂ → 2Cl•", "CH₄ + Cl• → CH₃• + HCl", "CH₃• + Cl₂ → CH₃Cl + Cl•", "CH₃• + Cl• → CH₃Cl" }, a = 1, x = "Initiation creates radicals: UV light breaks the weak Cl–Cl bond homolytically. The next two are propagation steps, and the last is a termination step." },
			{ id = "HC-ALK-03", topic = "Alkanes", quick = false, q = "How many structural isomers of C₅H₁₁Cl can form when 2-methylbutane reacts with chlorine in UV light?", o = { "4", "3", "5", "6" }, a = 1, x = "2-methylbutane, (CH₃)₂CHCH₂CH₃, has four different kinds of H: on the two equivalent CH₃ groups at C1, on C2, on C3 and on C4. So 4 monochloro structural isomers." },
			{ id = "HC-ALE-01", topic = "Alkenes", quick = true, q = "What is seen when bromine water is shaken with an alkene?", o = { "The orange solution turns colourless.", "The purple solution turns colourless.", "A white precipitate forms.", "The colourless solution turns orange." }, a = 1, x = "Br₂ adds across the C=C (electrophilic addition), so the orange colour of bromine disappears. Purple to colourless is the test with KMnO₄." },
			{ id = "HC-ALE-02", topic = "Alkenes", quick = true, q = "What is the major product when HBr reacts with propene?", o = { "2-bromopropane", "1-bromopropane", "1,2-dibromopropane", "propan-2-ol" }, a = 1, x = "H⁺ adds to the end carbon to give the more stable secondary carbocation CH₃C⁺HCH₃, which Br⁻ then attacks (Markovnikov's rule)." },
			{ id = "HC-ALE-03", topic = "Alkenes", quick = false, q = "2-methylbut-2-ene, (CH₃)₂C=CHCH₃, is heated with acidified KMnO₄. What are the organic products?", o = { "propanone and ethanoic acid", "propanone and ethanal", "2-methylbutane-2,3-diol", "butanone and methanoic acid" }, a = 1, x = "Hot acidified KMnO₄ cleaves the C=C. The (CH₃)₂C= end becomes (CH₃)₂C=O, propanone. The =CHCH₃ end becomes CH₃CHO, which is further oxidised to CH₃COOH. The diol forms only with cold dilute KMnO₄." },
			{ id = "HC-ALE-04", topic = "Alkenes", quick = false, q = "Ethene is bubbled into bromine water containing dissolved sodium chloride. Which product is NOT formed?", o = { "ClCH₂CH₂Cl", "BrCH₂CH₂Br", "BrCH₂CH₂OH", "BrCH₂CH₂Cl" }, a = 1, x = "The first step is always attack by the electrophile Br^δ+, so every product contains Br. The carbocation is then attacked by whichever nucleophile reaches it: Br⁻, H₂O or Cl⁻. A product with no bromine cannot form." },
			{ id = "HC-ARE-01", topic = "Arenes", quick = false, q = "Why does benzene usually undergo substitution rather than addition?", o = { "Substitution keeps the stable delocalised π electron system intact.", "Benzene has no π electrons to attack electrophiles.", "The C–H bonds in benzene are weaker than C=C bonds.", "Addition reactions need a catalyst, and substitution doesn't." }, a = 1, x = "Addition would destroy the delocalised ring of six π electrons and lose its extra stability. Substitution replaces an H and restores the delocalised system." },
			{ id = "HC-ARE-03", topic = "Arenes", quick = false, q = "Methylbenzene reacts with chlorine in ultraviolet light. What is the main organic product?", o = { "(chloromethyl)benzene, C₆H₅CH₂Cl", "1-chloro-2-methylbenzene", "1-chloro-4-methylbenzene", "chlorobenzene" }, a = 1, x = "UV light gives free-radical substitution on the CH₃ side chain. Substitution on the ring (2- and 4-positions) needs a halogen carrier such as AlCl₃ or FeCl₃ instead." },
			{ id = "HC-ARE-04", topic = "Arenes", quick = false, q = "Compared with benzene, how does methylbenzene behave in nitration?", o = { "It reacts faster, giving mainly 2- and 4-substituted products.", "It reacts faster, giving mainly the 3-substituted product.", "It reacts slower, giving mainly 2- and 4-substituted products.", "It reacts slower, giving mainly the 3-substituted product." }, a = 1, x = "The CH₃ group donates electron density to the ring, so it activates the ring to electrophilic attack and directs to the 2- and 4-positions." },
			{ id = "HC-ARE-05", topic = "Arenes", quick = false, q = "Which route makes 3-nitrobenzoic acid from methylbenzene in the best yield?", o = { "Heat with acidified KMnO₄, then nitrate with conc. HNO₃/H₂SO₄.", "Nitrate with conc. HNO₃/H₂SO₄, then heat with acidified KMnO₄.", "Nitrate with dilute HNO₃, then heat with acidified K₂Cr₂O₇.", "Heat with Cl₂ in UV light, then nitrate with conc. HNO₃/H₂SO₄." }, a = 1, x = "Oxidising first converts CH₃ (2,4-directing) to COOH, which is 3-directing, so nitration then goes to the 3-position. Nitrating first would put NO₂ at the 2- or 4-position." },
			{ id = "HC-HAL-01", topic = "Halogen Derivatives", quick = true, q = "What is the organic product when bromoethane is heated with aqueous NaOH?", o = { "ethanol", "ethene", "ethanoic acid", "ethylamine" }, a = 1, x = "In aqueous solution, OH⁻ acts as a nucleophile and replaces Br: CH₃CH₂Br + OH⁻ → CH₃CH₂OH + Br⁻ (nucleophilic substitution)." },
			{ id = "HC-HAL-02", topic = "Halogen Derivatives", quick = true, q = "What is the main organic product when bromoethane is heated with ethanolic KOH?", o = { "ethene", "ethanol", "ethoxyethane", "ethane" }, a = 1, x = "In ethanol, OH⁻ acts as a base and removes H⁺, giving elimination of HBr to form ethene. Aqueous conditions favour substitution instead." },
			{ id = "HC-HAL-03", topic = "Halogen Derivatives", quick = false, q = "Which halogenoalkane is hydrolysed fastest by water?", o = { "1-iodobutane", "1-bromobutane", "1-chlorobutane", "1-fluorobutane" }, a = 1, x = "The rate depends mainly on how easily the C–X bond breaks. C–I is the longest and weakest of these bonds, so iodoalkanes react fastest, even though C–F is the most polar." },
			{ id = "HC-HAL-04", topic = "Halogen Derivatives", quick = false, q = "Which statement about the hydrolysis of 2-bromo-2-methylpropane by OH⁻ is correct?", o = { "It goes through a carbocation intermediate.", "It goes through a single five-coordinate transition state with no intermediate.", "Its rate is proportional to [OH⁻].", "It is slower than for 1-bromobutane because the tertiary carbon is crowded." }, a = 1, x = "Tertiary halogenoalkanes react by SN1: C–Br breaks first to give a stable tertiary carbocation, which OH⁻ then attacks. The rate depends only on [RBr]. The single transition state describes SN2." },
			{ id = "HC-HAL-05", topic = "Halogen Derivatives", quick = false, q = "Optically active (R)-2-bromobutane is hydrolysed by an SN2 mechanism. What is the product?", o = { "optically active butan-2-ol with inverted configuration", "a racemic mixture of butan-2-ol", "optically active butan-2-ol with the same configuration", "optically inactive butan-1-ol" }, a = 1, x = "In SN2, OH⁻ attacks from the side opposite Br, so the configuration flips (Walden inversion) and a single enantiomer forms. A racemic mixture comes from SN1, where the planar carbocation can be attacked from either face." },
			{ id = "HC-HAL-06", topic = "Halogen Derivatives", quick = false, q = "Why is chlorobenzene not hydrolysed when heated with aqueous NaOH?", o = { "A lone pair on Cl overlaps with the ring π system, giving the C–Cl bond partial double-bond character.", "The C–Cl bond in chlorobenzene is more polar than in chloroethane.", "Chlorobenzene is insoluble in water, so it never meets OH⁻.", "OH⁻ attacks the ring instead and adds across a C=C bond." }, a = 1, x = "Delocalising Cl's lone pair into the ring strengthens the C–Cl bond. The electron-rich ring also repels the incoming nucleophile." },
			{ id = "HC-HYD-01", topic = "Hydroxy Compounds", quick = true, q = "Ethanol is heated under reflux with excess acidified K₂Cr₂O₇. What is the organic product and the colour change?", o = { "ethanoic acid; orange to green", "ethanal; orange to green", "ethanoic acid; green to orange", "ethene; purple to colourless" }, a = 1, x = "Under reflux with excess oxidant, a primary alcohol is fully oxidised to the carboxylic acid. Cr₂O₇²⁻ (orange) is reduced to Cr³⁺ (green). Distilling the product off as it forms would give ethanal instead." },
			{ id = "HC-HYD-02", topic = "Hydroxy Compounds", quick = true, q = "Which alcohol is NOT oxidised by hot acidified K₂Cr₂O₇?", o = { "2-methylpropan-2-ol", "butan-1-ol", "butan-2-ol", "2-methylpropan-1-ol" }, a = 1, x = "2-methylpropan-2-ol is tertiary: the carbon bearing OH has no H atom to lose, so it isn't oxidised. The others are primary or secondary." },
			{ id = "HC-HYD-03", topic = "Hydroxy Compounds", quick = false, q = "Which compound gives a yellow precipitate when warmed with alkaline aqueous iodine?", o = { "butan-2-ol", "propan-1-ol", "2-methylpropan-2-ol", "methanol" }, a = 1, x = "The iodoform (CHI₃) test is positive for CH₃CH(OH)– and CH₃CO– groups. Butan-2-ol is CH₃CH(OH)CH₂CH₃. The others lack a CH₃CH(OH)– group." },
			{ id = "HC-HYD-04", topic = "Hydroxy Compounds", quick = false, q = "Which compound reacts with aqueous NaOH but does NOT give CO₂ with aqueous Na₂CO₃?", o = { "phenol", "ethanol", "ethanoic acid", "benzoic acid" }, a = 1, x = "Phenol is acidic enough to react with NaOH (its anion is stabilised by delocalisation into the ring), but too weak to react with carbonate. Ethanol doesn't react with NaOH; the carboxylic acids react with both." },
			{ id = "HC-HYD-06", topic = "Hydroxy Compounds", quick = false, q = "Compound Y, C₇H₈O, gives H₂ with sodium but doesn't react with aqueous NaOH and doesn't decolourise bromine water. What is Y?", o = { "phenylmethanol", "4-methylphenol", "2-methylphenol", "methoxybenzene" }, a = 1, x = "Reacting with Na means Y has an OH group. Not reacting with NaOH or bromine water rules out a phenol, so the OH is on a side chain: C₆H₅CH₂OH. Methoxybenzene has no OH, so wouldn't react with Na." },
			{ id = "HC-CAR-01", topic = "Carbonyl Compounds", quick = true, q = "Which reagent gives an orange precipitate with both aldehydes and ketones?", o = { "2,4-dinitrophenylhydrazine", "Tollens' reagent", "Fehling's solution", "acidified potassium dichromate(VI)" }, a = 1, x = "2,4-DNPH undergoes condensation with any C=O group to give an orange 2,4-dinitrophenylhydrazone. Tollens', Fehling's and dichromate tests only respond to aldehydes, because ketones are not easily oxidised." },
			{ id = "HC-CAR-02", topic = "Carbonyl Compounds", quick = true, q = "Which test distinguishes propanal from propanone?", o = { "warming with Tollens' reagent", "adding 2,4-dinitrophenylhydrazine", "adding sodium metal", "adding aqueous bromine" }, a = 1, x = "Propanal, an aldehyde, is oxidised and reduces Ag⁺ to a silver mirror. Propanone, a ketone, does not react. Both give an orange precipitate with 2,4-DNPH." },
			{ id = "HC-CAR-03", topic = "Carbonyl Compounds", quick = false, q = "Ethanal reacts with HCN (with a trace of NaCN) to form 2-hydroxypropanenitrile, which has a chiral centre. Why is the product optically inactive?", o = { "The planar carbonyl group is attacked equally from both faces, giving a racemic mixture.", "The product has a plane of symmetry.", "The reaction goes through a carbocation that rearranges.", "CN⁻ attacks from the side opposite the oxygen, so only one enantiomer forms." }, a = 1, x = "The C=O carbon and its three substituents are trigonal planar. CN⁻ is equally likely to attack from above or below, so the two enantiomers form in equal amounts and their rotations cancel." },
			{ id = "HC-CAR-04", topic = "Carbonyl Compounds", quick = false, q = "Which compound gives a silver mirror with Tollens' reagent but no red-brown precipitate with Fehling's solution?", o = { "benzaldehyde", "ethanal", "propanone", "butanone" }, a = 1, x = "Aliphatic aldehydes like ethanal give both tests. Aromatic aldehydes such as benzaldehyde reduce Tollens' reagent but not Fehling's. Ketones give neither." },
			{ id = "HC-CAR-05", topic = "Carbonyl Compounds", quick = false, q = "Compound Z, C₄H₈O, gives an orange precipitate with 2,4-DNPH and a yellow precipitate with alkaline aqueous iodine, but no silver mirror with Tollens' reagent. What is Z?", o = { "butanone", "butanal", "2-methylpropanal", "but-3-en-2-ol" }, a = 1, x = "2,4-DNPH shows a C=O group; no reaction with Tollens' means a ketone; the iodoform test needs CH₃CO–. Only CH₃COCH₂CH₃ fits. But-3-en-2-ol gives iodoform but has no C=O." },
			{ id = "HC-CXA-02", topic = "Carboxylic Acids and Derivatives", quick = true, q = "Which is the strongest acid?", o = { "Cl₂CHCOOH", "ClCH₂COOH", "CH₃COOH", "CH₃CH₂COOH" }, a = 1, x = "Electron-withdrawing Cl atoms spread out the negative charge on the carboxylate ion and stabilise it, so two Cl atoms give the strongest acid. Alkyl groups donate electrons and weaken the acid." },
			{ id = "HC-CXA-03", topic = "Carboxylic Acids and Derivatives", quick = false, q = "Put these in order of ease of hydrolysis, easiest first: CH₃COCl, CH₃CH₂Cl, C₆H₅Cl.", o = { "CH₃COCl > CH₃CH₂Cl > C₆H₅Cl", "CH₃CH₂Cl > CH₃COCl > C₆H₅Cl", "C₆H₅Cl > CH₃CH₂Cl > CH₃COCl", "CH₃COCl > C₆H₅Cl > CH₃CH₂Cl" }, a = 1, x = "In an acyl chloride the carbon is bonded to both O and Cl, so it is very electron-deficient and reacts with cold water. Chloroalkanes need heating with NaOH(aq). Chlorobenzene's C–Cl bond is strengthened by delocalisation, so it barely hydrolyses." },
			{ id = "HC-CXA-04", topic = "Carboxylic Acids and Derivatives", quick = false, q = "What are the products when ethyl propanoate is heated under reflux with aqueous NaOH?", o = { "sodium propanoate and ethanol", "propanoic acid and ethanol", "sodium ethanoate and propan-1-ol", "propanoic acid and sodium ethoxide" }, a = 1, x = "Alkaline hydrolysis of CH₃CH₂COOCH₂CH₃ gives the carboxylate salt of the acid part, CH₃CH₂COO⁻Na⁺, and the alcohol part, ethanol. Acid hydrolysis would give the free carboxylic acid." },
			{ id = "HC-NIT-01", topic = "Nitrogen Compounds", quick = true, q = "Which reagents convert nitrobenzene into phenylamine?", o = { "tin and concentrated HCl, then NaOH(aq)", "LiAlH₄ in dry ether, then H₂O", "concentrated HNO₃ and H₂SO₄", "NH₃ in ethanol, heated in a sealed tube" }, a = 1, x = "Sn/conc. HCl reduces –NO₂ to –NH₃⁺; NaOH is then added to release the free amine. Concentrated HNO₃/H₂SO₄ is the nitrating mixture." },
			{ id = "HC-NIT-02", topic = "Nitrogen Compounds", quick = true, q = "Which shows ethylamine, ammonia and phenylamine in order of decreasing base strength?", o = { "ethylamine > ammonia > phenylamine", "phenylamine > ammonia > ethylamine", "ammonia > ethylamine > phenylamine", "ethylamine > phenylamine > ammonia" }, a = 1, x = "The ethyl group donates electrons, making the N lone pair more available to accept H⁺. In phenylamine the lone pair is delocalised into the benzene ring, making it less available." },
			{ id = "HC-NIT-03", topic = "Nitrogen Compounds", quick = false, q = "Why is ethanamide, CH₃CONH₂, almost neutral rather than basic?", o = { "The lone pair on N is delocalised over the C=O group.", "The N atom has no lone pair.", "Ethanamide is insoluble in water.", "The C=O group donates electrons to the N atom." }, a = 1, x = "The N lone pair overlaps with the π system of the neighbouring C=O, and the electronegative O draws electron density away. The lone pair is much less available to accept a proton." },
			{ id = "HC-NIT-04", topic = "Nitrogen Compounds", quick = false, q = "What is the organic product when ethanoyl chloride reacts with ethylamine?", o = { "N-ethylethanamide, CH₃CONHCH₂CH₃", "ethyl ethanoate, CH₃COOCH₂CH₃", "ethanamide, CH₃CONH₂", "diethylamine, (CH₃CH₂)₂NH" }, a = 1, x = "This is a condensation (nucleophilic acyl substitution): the amine N attacks the carbonyl carbon and HCl is lost, forming an amide link." },
			{ id = "HC-NIT-05", topic = "Nitrogen Compounds", quick = false, q = "In which form does glycine, H₂NCH₂COOH, mainly exist in a solution of pH 1?", o = { "H₃N⁺CH₂COOH", "H₃N⁺CH₂COO⁻", "H₂NCH₂COO⁻", "H₂NCH₂COOH" }, a = 1, x = "At very low pH there is plenty of H⁺, so both the amine group (protonated to –NH₃⁺) and the carboxylate (as –COOH) carry H. The zwitterion dominates near the isoelectric point, and the anion at high pH." },
			{ id = "HC-NIT-06", topic = "Nitrogen Compounds", quick = false, q = "How many different tripeptides can be made that each contain one glycine, one alanine and one serine residue?", o = { "6", "3", "9", "27" }, a = 1, x = "A peptide has a direction (N-terminus to C-terminus), so each order is a different molecule: 3 × 2 × 1 = 6. 27 would allow amino acids to repeat." },
		},
	},
	bio = {
		name = "H2 Biology",
		constants = "",
		questions = {
			{ id = "HB-CEL-01", topic = "Cell Structure", quick = true, q = "Which organelle modifies, sorts and packages proteins into vesicles for secretion?", o = { "Golgi apparatus", "rough endoplasmic reticulum", "lysosome", "nucleolus" }, a = 1, x = "The Golgi apparatus receives proteins from the RER, modifies them (for example by glycosylation), and packages them into secretory vesicles. The RER makes the proteins; the nucleolus makes rRNA." },
			{ id = "HB-CEL-02", topic = "Cell Structure", quick = true, q = "Which structure is found in both prokaryotic and eukaryotic cells?", o = { "ribosomes", "nucleus", "mitochondria", "endoplasmic reticulum" }, a = 1, x = "All cells have ribosomes for protein synthesis: 70S in prokaryotes and 80S in the eukaryotic cytoplasm. Prokaryotes have no membrane-bound organelles." },
			{ id = "HB-CEL-03", topic = "Cell Structure", quick = false, q = "Which is the correct pathway for a secretory protein after it is made?", o = { "rough ER → transport vesicle → Golgi apparatus → secretory vesicle → cell surface membrane", "Golgi apparatus → rough ER → secretory vesicle → cell surface membrane", "rough ER → lysosome → Golgi apparatus → cell surface membrane", "free ribosome → nucleus → Golgi apparatus → cell surface membrane" }, a = 1, x = "Ribosomes on the RER make the protein into the ER lumen. Transport vesicles carry it to the Golgi, which packages it into secretory vesicles that fuse with the membrane (exocytosis)." },
			{ id = "HB-CEL-05", topic = "Cell Structure", quick = false, q = "A cell has an unusually large amount of rough ER and many Golgi stacks. What is its most likely function?", o = { "secreting proteins, such as digestive enzymes", "storing lipids", "carrying out rapid aerobic respiration for muscle contraction", "detoxifying drugs" }, a = 1, x = "Rough ER makes proteins for export and the Golgi packages them, so a cell rich in both (such as a pancreatic acinar cell) secretes proteins. Drug detoxification and lipid synthesis involve smooth ER." },
			{ id = "HB-BIO-01", topic = "Biomolecules", quick = true, q = "Which bond links the glucose residues in amylose?", o = { "α(1→4) glycosidic bonds", "β(1→4) glycosidic bonds", "α(1→6) glycosidic bonds", "peptide bonds" }, a = 1, x = "Amylose is an unbranched chain of α-glucose joined by α(1→4) glycosidic bonds, which makes it coil into a helix. β(1→4) bonds are in cellulose; α(1→6) bonds form the branches in amylopectin and glycogen." },
			{ id = "HB-BIO-03", topic = "Biomolecules", quick = false, q = "Which feature of cellulose gives it high tensile strength?", o = { "Straight chains of β-glucose lie side by side and are held together by many hydrogen bonds, forming microfibrils.", "Its α-glucose chains coil into compact helices.", "It is highly branched, with many α(1→6) bonds.", "Disulfide bonds cross-link its chains." }, a = 1, x = "Alternate β-glucose residues are inverted, so the chain is straight. Parallel chains form many hydrogen bonds with each other, bundling into strong microfibrils. Helices and branches describe starch and glycogen." },
			{ id = "HB-BIO-04", topic = "Biomolecules", quick = false, q = "Why is glycogen's highly branched structure an advantage for an animal?", o = { "It has many free ends, so enzymes can hydrolyse it quickly to release glucose.", "Branching makes it soluble, so it can travel in the blood.", "Branching lets it form hydrogen bonds with cellulose.", "Its branches store more energy per gram than lipids." }, a = 1, x = "Each branch ends in a glucose that enzymes can remove, so many glucose molecules can be released at once when energy is needed. Glycogen is insoluble and stays in cells; lipids store more energy per gram." },
			{ id = "HB-BIO-05", topic = "Biomolecules", quick = false, q = "Which property of phospholipids allows them to form a bilayer in water?", o = { "Each molecule has a hydrophilic phosphate head and two hydrophobic fatty acid tails.", "They have three fatty acid tails that repel water.", "They are polymers of glycerol linked by peptide bonds.", "They are fully soluble in water." }, a = 1, x = "Phospholipids are amphipathic. In water the heads face the water on both sides while the tails point inwards, away from it, forming a bilayer. Three tails would make it a triglyceride." },
			{ id = "HB-ENZ-01", topic = "Proteins and Enzymes", quick = true, q = "Which level of protein structure is the sequence of amino acids in a polypeptide?", o = { "primary", "secondary", "tertiary", "quaternary" }, a = 1, x = "The primary structure is the amino acid sequence, held by peptide bonds. It determines how the chain folds into its secondary and tertiary structures." },
			{ id = "HB-ENZ-02", topic = "Proteins and Enzymes", quick = false, q = "Which bonds hold the α-helix and β-pleated sheet in shape?", o = { "hydrogen bonds between C=O and N–H groups of the polypeptide backbone", "disulfide bonds between cysteine R groups", "ionic bonds between charged R groups", "peptide bonds between adjacent amino acids" }, a = 1, x = "Secondary structure is stabilised by hydrogen bonds within the backbone. Disulfide, ionic and hydrophobic interactions between R groups belong to tertiary structure." },
			{ id = "HB-ENZ-03", topic = "Proteins and Enzymes", quick = false, q = "How does a competitive inhibitor affect an enzyme-catalysed reaction?", o = { "It lowers the rate, but adding enough substrate still reaches the same maximum rate.", "It lowers the maximum rate, however much substrate is added.", "It permanently denatures the enzyme.", "It binds to the substrate and changes its shape." }, a = 1, x = "A competitive inhibitor resembles the substrate and competes for the active site. At high substrate concentration the substrate outcompetes it, so Vmax is unchanged (but more substrate is needed to reach it)." },
			{ id = "HB-ENZ-04", topic = "Proteins and Enzymes", quick = false, q = "Adding more substrate does not restore the rate of an inhibited enzyme. The inhibitor most likely:", o = { "binds to a site other than the active site and changes the active site's shape", "has a shape similar to the substrate and binds to the active site", "is hydrolysed by the enzyme", "binds to the substrate rather than the enzyme" }, a = 1, x = "A non-competitive inhibitor binds to an allosteric site, altering the shape of the active site. Substrate cannot displace it, so Vmax is lowered whatever the substrate concentration." },
			{ id = "HB-ENZ-05", topic = "Proteins and Enzymes", quick = false, q = "In a pathway A → B → C → D, product D inhibits the first enzyme by binding to its allosteric site. What happens when D builds up?", o = { "Conversion of A to B slows, so less D is made: negative feedback.", "Conversion of A to B speeds up, so D accumulates further.", "Only the enzyme converting C to D is affected.", "A is converted directly into D." }, a = 1, x = "This is end-product inhibition. Excess D switches off the first enzyme, which reduces flow through the whole pathway and saves resources. When D is used up, the inhibition is released." },
			{ id = "HB-ENZ-06", topic = "Proteins and Enzymes", quick = true, q = "Above an enzyme's optimum temperature, why does its rate fall sharply?", o = { "Hydrogen and ionic bonds holding the tertiary structure break, so the active site changes shape and substrates no longer fit.", "Peptide bonds are hydrolysed, so the enzyme breaks into amino acids.", "Molecules move too fast to collide.", "The substrate is denatured." }, a = 1, x = "Increased vibration breaks the weaker bonds that maintain tertiary structure. The active site loses its complementary shape: the enzyme is denatured. Peptide bonds stay intact." },
			{ id = "HB-MEM-01", topic = "Cell Membranes and Transport", quick = true, q = "How does oxygen cross the cell surface membrane?", o = { "simple diffusion through the phospholipid bilayer", "facilitated diffusion through channel proteins", "active transport by carrier proteins", "endocytosis" }, a = 1, x = "O₂ is small and non-polar, so it passes directly through the hydrophobic core of the bilayer, down its concentration gradient. No protein or ATP is needed." },
			{ id = "HB-MEM-02", topic = "Cell Membranes and Transport", quick = true, q = "Glucose enters red blood cells down its concentration gradient through a specific carrier protein, without using ATP. What is this process?", o = { "facilitated diffusion", "simple diffusion", "active transport", "osmosis" }, a = 1, x = "Glucose is large and polar, so it needs a carrier (GLUT1). Moving down its gradient without ATP is facilitated diffusion." },
			{ id = "HB-MEM-03", topic = "Cell Membranes and Transport", quick = false, q = "What is the role of cholesterol in animal cell membranes?", o = { "It regulates fluidity: it restrains phospholipid movement when warm and stops tight packing when cold.", "It acts as a receptor for hormones.", "It forms channels for ions.", "It makes the membrane permeable to water." }, a = 1, x = "Cholesterol sits between phospholipid tails. It reduces fluidity at higher temperatures and prevents the tails packing and solidifying at low temperatures, buffering membrane fluidity." },
			{ id = "HB-MEM-04", topic = "Cell Membranes and Transport", quick = false, q = "A plant cell with a water potential of −400 kPa is placed in a solution of −600 kPa. What happens?", o = { "Water leaves the cell by osmosis, and the cell may plasmolyse.", "Water enters the cell, and it becomes turgid.", "There is no net movement of water.", "Solutes move into the cell by osmosis." }, a = 1, x = "Water moves from higher (less negative) to lower (more negative) water potential: from the cell (−400) to the solution (−600). The protoplast shrinks and may pull away from the wall." },
			{ id = "HB-MEM-05", topic = "Cell Membranes and Transport", quick = false, q = "For each ATP hydrolysed, what does the Na⁺/K⁺ pump move?", o = { "3 Na⁺ out of the cell and 2 K⁺ into the cell", "2 Na⁺ out of the cell and 3 K⁺ into the cell", "3 Na⁺ into the cell and 2 K⁺ out of the cell", "1 Na⁺ out of the cell and 1 K⁺ into the cell" }, a = 1, x = "The pump exports 3 Na⁺ and imports 2 K⁺ per ATP, both against their gradients. This unequal exchange helps make the inside of the cell negative." },
			{ id = "HB-MEM-06", topic = "Cell Membranes and Transport", quick = false, q = "Root hair cells are treated with cyanide, which stops aerobic respiration. Which process is most reduced?", o = { "uptake of mineral ions against their concentration gradient", "uptake of water by osmosis", "diffusion of CO₂ out of the cells", "diffusion of O₂ into the cells" }, a = 1, x = "Active transport needs ATP, which comes mainly from aerobic respiration. Osmosis and diffusion are passive and continue without ATP." },
			{ id = "HB-DIV-02", topic = "Cell Division", quick = false, q = "A diploid cell contains 20 pg of DNA in G1. How much DNA is in each cell at the end of meiosis II?", o = { "10 pg", "5 pg", "20 pg", "40 pg" }, a = 1, x = "S phase doubles it to 40 pg. Meiosis I separates homologues: 20 pg per cell. Meiosis II separates sister chromatids: 10 pg per cell, half the G1 amount." },
			{ id = "HB-DIV-03", topic = "Cell Division", quick = false, q = "When and between which structures does crossing over occur?", o = { "prophase I, between non-sister chromatids of homologous chromosomes", "prophase I, between sister chromatids of the same chromosome", "metaphase II, between non-homologous chromosomes", "anaphase I, between sister chromatids" }, a = 1, x = "Homologous chromosomes pair up (synapsis) in prophase I. Chiasmata form between non-sister chromatids, which exchange sections. Swapping between identical sister chromatids would produce no new combinations." },
			{ id = "HB-DIV-04", topic = "Cell Division", quick = false, q = "An organism has a diploid number of 8. Ignoring crossing over, how many genetically different gametes can independent assortment produce?", o = { "16", "4", "8", "64" }, a = 1, x = "2n = 8 means n = 4 homologous pairs. Each pair can line up two ways in metaphase I, so there are 2⁴ = 16 combinations." },
			{ id = "HB-DIV-05", topic = "Cell Division", quick = false, q = "A cell is heterozygous, Aa. A crossover happens between gene A and the centromere. When do alleles A and a separate into different cells?", o = { "anaphase II", "anaphase I", "prophase I", "telophase I" }, a = 1, x = "After the crossover each homologue has one A chromatid and one a chromatid. Anaphase I separates homologues, so each cell still has both alleles. They separate only when sister chromatids part in anaphase II." },
			{ id = "HB-DIV-06", topic = "Cell Division", quick = false, q = "Which statement about tumour suppressor genes is correct?", o = { "Cancer usually needs loss-of-function mutations in both alleles.", "A gain-of-function mutation in one allele is enough to cause uncontrolled division.", "They code for growth factors that stimulate the cell cycle.", "Their normal products speed up passage through cell cycle checkpoints." }, a = 1, x = "Tumour suppressors such as p53 normally halt the cell cycle or trigger apoptosis. One working allele is usually enough, so both must be lost. A single gain-of-function mutation describes a proto-oncogene becoming an oncogene." },
			{ id = "HB-DNA-02", topic = "DNA Structure and Replication", quick = false, q = "Bacteria grown for many generations in ¹⁵N are moved to ¹⁴N and allowed to divide twice. What DNA is found after the second division?", o = { "50% hybrid (¹⁵N/¹⁴N) and 50% light (¹⁴N/¹⁴N)", "100% hybrid", "25% heavy, 50% hybrid and 25% light", "50% heavy and 50% light" }, a = 1, x = "Replication is semi-conservative. After one division all DNA is hybrid. In the second, each hybrid molecule gives one hybrid and one fully light molecule." },
			{ id = "HB-DNA-04", topic = "DNA Structure and Replication", quick = false, q = "Why is one strand replicated discontinuously, as Okazaki fragments?", o = { "DNA polymerase can only add nucleotides to a 3′ end, so it builds new DNA 5′ → 3′, and one strand runs the opposite way to fork movement.", "Helicase can only unwind short sections at a time.", "The lagging strand template has more introns.", "RNA primers can only bind to one strand." }, a = 1, x = "The template strands are antiparallel. On one, synthesis 5′ → 3′ follows the fork (leading strand); on the other it runs away from the fork, so it is made in short pieces, each needing a new primer." },
			{ id = "HB-DNA-05", topic = "DNA Structure and Replication", quick = false, q = "Why do linear chromosomes get shorter after each round of replication in most somatic cells?", o = { "When the last RNA primer at the end of the lagging strand is removed, DNA polymerase cannot fill the gap because there is no 3′-OH to extend.", "DNA ligase cannot join the leading strand to the telomere.", "Helicase cannot unwind the tightly coiled telomere.", "Telomerase removes nucleotides from the ends of chromosomes." }, a = 1, x = "This is the end-replication problem. Repeated non-coding telomeres act as a buffer so genes aren't lost. Telomerase, active in germ cells and many cancers, adds repeats back rather than removing them." },
			{ id = "HB-GEX-01", topic = "Gene Expression", quick = true, q = "An mRNA codon is 5′-AUG-3′. What is the anticodon on the tRNA that pairs with it?", o = { "3′-UAC-5′", "5′-UAC-3′", "3′-TAC-5′", "3′-AUG-5′" }, a = 1, x = "The anticodon is complementary and antiparallel: A–U, U–A, G–C, reading 3′-UAC-5′ (also written 5′-CAU-3′). RNA has U, not T." },
			{ id = "HB-GEX-03", topic = "Gene Expression", quick = false, q = "Which is NOT a modification of eukaryotic pre-mRNA?", o = { "glycosylation in the Golgi apparatus", "adding a 5′ methylguanosine cap", "adding a poly(A) tail", "splicing out introns" }, a = 1, x = "Capping, polyadenylation and splicing happen in the nucleus and make mature mRNA. Glycosylation adds sugars to proteins in the ER and Golgi; it doesn't happen to mRNA." },
			{ id = "HB-GEX-04", topic = "Gene Expression", quick = false, q = "The coding region of an mRNA, from the start codon to the stop codon inclusive, is 903 nucleotides long. How many amino acids are in the polypeptide made?", o = { "300", "301", "903", "100" }, a = 1, x = "903 / 3 = 301 codons. The stop codon codes for no amino acid, so 300 amino acids are joined." },
			{ id = "HB-GEX-05", topic = "Gene Expression", quick = false, q = "Why can translation start on an mRNA before its transcription is finished in bacteria, but not in eukaryotes?", o = { "Bacteria have no nuclear envelope separating transcription from translation.", "Bacterial ribosomes are smaller and move faster.", "Bacterial mRNA has no start codon.", "Bacteria have no RNA polymerase." }, a = 1, x = "In bacteria both processes happen in the cytoplasm, so ribosomes attach to the mRNA as it is made. In eukaryotes mRNA is made and processed in the nucleus and must be exported first." },
			{ id = "HB-MUT-01", topic = "Mutations", quick = false, q = "Why is inserting one nucleotide near the start of a gene usually more harmful than substituting one nucleotide?", o = { "It shifts the reading frame, changing every codon after it.", "It always creates a stop codon at that point.", "It changes the gene's promoter.", "Insertions can't be repaired, but substitutions always are." }, a = 1, x = "Codons are read in triplets with no gaps, so an insertion is a frameshift that alters all downstream amino acids. A substitution changes at most one codon and, since the code is degenerate, may change nothing." },
			{ id = "HB-MUT-02", topic = "Mutations", quick = false, q = "What is the mutation that causes sickle cell anaemia?", o = { "A base substitution in the β-globin gene changes glutamic acid to valine.", "A deletion removes the whole β-globin gene.", "A frameshift in the α-globin gene creates an early stop codon.", "An extra copy of chromosome 11 doubles the amount of β-globin." }, a = 1, x = "A single substitution in codon 6 (GAG → GTG on the coding strand) replaces polar glutamic acid with non-polar valine. The new hydrophobic patch makes HbS molecules stick together at low oxygen, distorting red cells." },
			{ id = "HB-MUT-03", topic = "Mutations", quick = false, q = "Part of a gene's coding strand reads 5′-ATG GCA TGG AAA-3′. The 9th nucleotide changes from G to A. What type of mutation is this? (Stop codons: UAA, UAG, UGA.)", o = { "nonsense", "silent", "missense", "frameshift" }, a = 1, x = "TGG becomes TGA, so the mRNA codon changes from UGG (tryptophan) to UGA, a stop codon. Translation ends early: a nonsense mutation." },
			{ id = "HB-MUT-04", topic = "Mutations", quick = false, q = "Three consecutive nucleotides, making up exactly one codon, are deleted from the middle of a gene. What is the most likely result?", o = { "The polypeptide lacks one amino acid but is otherwise unchanged.", "Every amino acid after the deletion is different.", "No polypeptide is made at all.", "The polypeptide gains one extra amino acid." }, a = 1, x = "Removing a whole codon keeps the reading frame, so only one amino acid is lost. The CFTR ΔF508 mutation in cystic fibrosis is an example; even one missing amino acid can stop the protein folding properly." },
			{ id = "HB-CTL-01", topic = "Control of Gene Expression", quick = true, q = "In the lac operon, where does the active repressor protein bind?", o = { "operator", "promoter", "lacI gene", "lacZ gene" }, a = 1, x = "The repressor binds the operator, which overlaps the promoter, blocking RNA polymerase from transcribing lacZ, lacY and lacA. lacI is the gene that codes for the repressor." },
			{ id = "HB-CTL-02", topic = "Control of Gene Expression", quick = false, q = "Under which conditions is the lac operon transcribed at the highest rate?", o = { "lactose present, glucose absent", "lactose present, glucose present", "lactose absent, glucose absent", "lactose absent, glucose present" }, a = 1, x = "Lactose (as allolactose) removes the repressor. With no glucose, cAMP is high and the CAP–cAMP complex binds near the promoter, strongly increasing transcription." },
			{ id = "HB-CTL-03", topic = "Control of Gene Expression", quick = false, q = "How does tryptophan switch off the trp operon?", o = { "It binds the inactive repressor and activates it, so the repressor binds the operator.", "It binds the active repressor and removes it from the operator.", "It binds RNA polymerase directly and inhibits it.", "It is broken down to produce cAMP, which blocks the promoter." }, a = 1, x = "The trp operon is repressible. Its repressor is made inactive; tryptophan acts as a corepressor that changes its shape so it can bind the operator. The lac operon is the inducible one, where the inducer removes the repressor." },
			{ id = "HB-CTL-04", topic = "Control of Gene Expression", quick = false, q = "A mutation in lacI makes a repressor that can't bind the operator. What happens to the lac structural genes?", o = { "They are transcribed even when lactose is absent.", "They are never transcribed.", "They are transcribed only when glucose is present.", "They are transcribed only when lactose is present, as normal." }, a = 1, x = "Without a repressor on the operator, nothing blocks RNA polymerase, so the genes are expressed constitutively, whether or not lactose is present." },
			{ id = "HB-CTL-05", topic = "Control of Gene Expression", quick = false, q = "A mutation in lacI makes a repressor that still binds the operator but can no longer bind allolactose. What happens when lactose is added and glucose is absent?", o = { "The structural genes stay switched off.", "The structural genes are transcribed at a high rate.", "The structural genes are transcribed at a low rate, without CAP.", "The repressor is degraded and transcription starts." }, a = 1, x = "Allolactose normally changes the repressor's shape so it falls off the operator. If it can't bind, the repressor stays on, so the operon can't be induced even when it would be most useful." },
			{ id = "HB-CTL-06", topic = "Control of Gene Expression", quick = false, q = "Which change makes a eukaryotic gene more likely to be transcribed?", o = { "acetylation of histones near the gene", "methylation of cytosines in the promoter", "packing of the region into heterochromatin", "removal of transcription factors from the enhancer" }, a = 1, x = "Acetylation neutralises positive charges on histones, loosening their grip on DNA. The chromatin opens (euchromatin), so transcription factors and RNA polymerase can reach the promoter. The other three all silence genes." },
			{ id = "HB-CTL-07", topic = "Control of Gene Expression", quick = false, q = "An enhancer lies 20 kb upstream of a gene's promoter. How can it increase transcription from so far away?", o = { "Activator proteins bind the enhancer, the DNA loops, and they help assemble the transcription initiation complex at the promoter.", "RNA polymerase starts transcribing at the enhancer and continues to the gene.", "The enhancer is transcribed into a protein that acts as a transcription factor.", "The enhancer is cut out and inserted next to the promoter." }, a = 1, x = "DNA bending brings enhancer-bound activators into contact with mediator proteins and general transcription factors at the promoter, stabilising RNA polymerase binding there." },
			{ id = "HB-INH-01", topic = "Inheritance", quick = true, q = "Two heterozygous tall plants (Tt) are crossed. Tall is dominant. What is the expected ratio of tall to short offspring?", o = { "3 : 1", "1 : 1", "1 : 2 : 1", "9 : 3 : 3 : 1" }, a = 1, x = "Tt × Tt gives 1 TT : 2 Tt : 1 tt. TT and Tt are both tall, so 3 tall : 1 short. 1 : 2 : 1 is the genotype ratio." },
			{ id = "HB-INH-02", topic = "Inheritance", quick = true, q = "A plant with the dominant phenotype is crossed with a homozygous recessive plant. Half the offspring show the recessive phenotype. What was the genotype of the dominant parent?", o = { "heterozygous", "homozygous dominant", "homozygous recessive", "It cannot be worked out." }, a = 1, x = "In a test cross, Aa × aa gives 1 Aa : 1 aa. A homozygous AA parent would give only dominant offspring." },
			{ id = "HB-INH-03", topic = "Inheritance", quick = true, q = "Two plants heterozygous at two unlinked genes (AaBb × AaBb) are crossed. What fraction of the offspring is aabb?", o = { "1/16", "1/4", "3/16", "9/16" }, a = 1, x = "For independently assorting genes, multiply: P(aa) × P(bb) = 1/4 × 1/4 = 1/16." },
			{ id = "HB-INH-04", topic = "Inheritance", quick = false, q = "Red–green colour blindness is X-linked recessive. A carrier woman and a man with normal vision have a son. What is the probability that he is colour-blind?", o = { "1/2", "1/4", "0", "1" }, a = 1, x = "A son always gets his Y from his father and an X from his mother. The mother is XᴮXᵇ, so the son has a 1/2 chance of XᵇY. (1/4 is the chance for any child before knowing its sex.)" },
			{ id = "HB-INH-05", topic = "Inheritance", quick = false, q = "A dihybrid cross gives an F₂ ratio of 9 : 3 : 4. What does this suggest?", o = { "recessive epistasis", "dominant epistasis", "codominance", "linked genes" }, a = 1, x = "The usual 9 : 3 : 3 : 1 becomes 9 : 3 : 4 when a homozygous recessive at one gene (aa) hides the other gene, merging the last two classes (3 + 1). Dominant epistasis typically gives 12 : 3 : 1." },
			{ id = "HB-INH-06", topic = "Inheritance", quick = false, q = "A test cross AaBb × aabb gives 42% AB, 42% ab, 8% Ab and 8% aB phenotypes. What is the recombination frequency between the genes?", o = { "16%", "8%", "42%", "84%" }, a = 1, x = "The two large classes are parental; the two small ones are recombinants formed by crossing over. 8% + 8% = 16%, so the genes are linked and about 16 map units apart." },
			{ id = "HB-INH-07", topic = "Inheritance", quick = false, q = "A χ² test on a dihybrid cross gives χ² = 2.1 with 3 degrees of freedom. The critical value at p = 0.05 is 7.82. What can be concluded?", o = { "The difference from the 9 : 3 : 3 : 1 ratio is not significant and is due to chance.", "The difference is significant, so the genes must be linked.", "The results prove the genes assort independently.", "There are too few degrees of freedom to use the test." }, a = 1, x = "2.1 is below the critical value, so p > 0.05: we accept the null hypothesis that the results fit the expected ratio. A χ² test can't 'prove' a hypothesis, only fail to reject it." },
			{ id = "HB-INH-08", topic = "Inheritance", quick = false, q = "A father with blood group A and a mother with blood group B have a child with blood group O. What is the probability that their next child has blood group AB?", o = { "1/4", "1/2", "0", "3/4" }, a = 1, x = "An O child is IᴼIᴼ, so both parents must be heterozygous: IᴬIᴼ × IᴮIᴼ. The chance of Iᴬ from the father and Iᴮ from the mother is 1/2 × 1/2 = 1/4." },
			{ id = "HB-VIR-02", topic = "Viruses", quick = false, q = "What happens to phage DNA during the lysogenic cycle?", o = { "It is integrated into the bacterial chromosome as a prophage and copied each time the cell divides.", "It is copied many times, and new phages burst out of the cell.", "It is broken down by bacterial restriction enzymes.", "It is reverse-transcribed into RNA." }, a = 1, x = "In lysogeny the phage genome stays dormant within the host chromosome and passes to daughter cells. A trigger can later switch it into the lytic cycle, which ends with lysis." },
			{ id = "HB-VIR-03", topic = "Viruses", quick = false, q = "How does antigenic shift produce a new influenza strain?", o = { "Two different strains infect the same cell and their RNA segments are reassorted into new virus particles.", "Point mutations slowly accumulate in the haemagglutinin gene.", "The virus integrates into the host genome and picks up human genes.", "Antibodies cause the virus to change its surface proteins." }, a = 1, x = "Influenza's genome is in 8 separate RNA segments. When two strains (for example avian and human) infect one cell, segments mix, giving sudden major changes in haemagglutinin or neuraminidase. Gradual point mutations are antigenic drift." },
			{ id = "HB-VIR-04", topic = "Viruses", quick = true, q = "Why are antibiotics ineffective against viral infections?", o = { "Viruses have no cell wall, ribosomes or metabolism of their own for antibiotics to target.", "Viruses are too small for antibiotics to reach.", "Viruses quickly break antibiotics down with enzymes.", "Viruses live only outside host cells." }, a = 1, x = "Antibiotics target bacterial structures such as peptidoglycan walls and 70S ribosomes. Viruses replicate using the host's machinery, so there is nothing for antibiotics to act on." },
			{ id = "HB-VIR-05", topic = "Viruses", quick = false, q = "Why can't antiretroviral drugs completely cure an HIV infection?", o = { "The provirus stays integrated and inactive in long-lived memory T cells, where the drugs can't reach it.", "HIV has a DNA genome that the drugs can't recognise.", "The drugs kill all helper T cells.", "HIV infects only red blood cells." }, a = 1, x = "Antiretrovirals block steps such as reverse transcription. A latent provirus isn't using those steps, so it survives and can reactivate if treatment stops." },
			{ id = "HB-BAC-01", topic = "Bacteria", quick = true, q = "A bacterium transfers a copy of a plasmid to another bacterium through a pilus. What is this process?", o = { "conjugation", "transformation", "transduction", "binary fission" }, a = 1, x = "In conjugation, a donor with an F plasmid makes a sex pilus that joins it to a recipient, and DNA passes between them. Transformation is uptake of free DNA; transduction uses a phage." },
			{ id = "HB-BAC-02", topic = "Bacteria", quick = false, q = "Griffith injected mice with heat-killed virulent S bacteria mixed with live harmless R bacteria. The mice died and live S bacteria were found in them. What process explains this?", o = { "transformation", "conjugation", "transduction", "mutation of the R bacteria caused by heat" }, a = 1, x = "The live R bacteria took up DNA released from the dead S bacteria, including the genes for the capsule, and became virulent." },
			{ id = "HB-BAC-03", topic = "Bacteria", quick = false, q = "Two bacterial strains are kept apart by a filter that lets viruses through but not bacteria. Recombinant bacteria still appear, even after DNase is added. How were genes transferred?", o = { "transduction", "transformation", "conjugation", "binary fission" }, a = 1, x = "The filter stops cell contact, ruling out conjugation. DNase would destroy free DNA, ruling out transformation. DNA inside a phage capsid is protected and passes the filter, so transduction is responsible." },
			{ id = "HB-PHO-01", topic = "Photosynthesis", quick = true, q = "Where in the chloroplast does the Calvin cycle take place?", o = { "stroma", "thylakoid membrane", "thylakoid lumen", "intermembrane space" }, a = 1, x = "The Calvin cycle enzymes, including RuBisCO, are in the stroma. The light-dependent reactions happen on the thylakoid membranes." },
			{ id = "HB-PHO-02", topic = "Photosynthesis", quick = true, q = "Which products of the light-dependent reactions are used in the Calvin cycle?", o = { "ATP and reduced NADP", "ATP and oxygen", "reduced NADP and oxygen", "glucose and ATP" }, a = 1, x = "ATP and reduced NADP are used to reduce GP to triose phosphate, and ATP also regenerates RuBP. Oxygen is a waste product." },
			{ id = "HB-PHO-03", topic = "Photosynthesis", quick = false, q = "In non-cyclic photophosphorylation, where do the electrons that replace those lost by photosystem II come from?", o = { "water", "reduced NADP", "photosystem I", "carbon dioxide" }, a = 1, x = "Photolysis splits water: 2H₂O → 4H⁺ + 4e⁻ + O₂. The electrons refill PSII, and this is the source of the oxygen released." },
			{ id = "HB-PHO-04", topic = "Photosynthesis", quick = false, q = "A plant in bright light suddenly has its CO₂ supply cut off. What happens immediately to RuBP and GP?", o = { "RuBP rises and GP falls.", "RuBP falls and GP rises.", "Both rise.", "Both fall." }, a = 1, x = "Without CO₂, RuBisCO can't fix RuBP into GP, so RuBP builds up. GP is still being converted to triose phosphate using ATP and reduced NADP, so it falls." },
			{ id = "HB-PHO-05", topic = "Photosynthesis", quick = false, q = "During the light-dependent reactions, where are protons concentrated, and where is ATP made?", o = { "Protons build up in the thylakoid lumen; ATP is made in the stroma.", "Protons build up in the stroma; ATP is made in the thylakoid lumen.", "Protons build up in the intermembrane space; ATP is made in the matrix.", "Protons build up in the cytoplasm; ATP is made in the stroma." }, a = 1, x = "The electron transport chain pumps H⁺ into the lumen, and photolysis adds more there. H⁺ flows back out through ATP synthase, which faces the stroma, where the Calvin cycle uses the ATP. The intermembrane space and matrix belong to mitochondria." },
			{ id = "HB-PHO-06", topic = "Photosynthesis", quick = false, q = "Light is available, but NADP⁺ is in short supply because the Calvin cycle has slowed. Which process continues, and what does it produce?", o = { "Cyclic photophosphorylation, producing ATP only.", "Non-cyclic photophosphorylation, producing ATP and reduced NADP.", "Photolysis, producing oxygen and reduced NADP.", "Cyclic photophosphorylation, producing ATP and oxygen." }, a = 1, x = "In cyclic flow, electrons from PSI return to the electron transport chain instead of reducing NADP⁺. This pumps protons and makes ATP, but PSII and photolysis aren't involved, so no reduced NADP or O₂ forms." },
			{ id = "HB-RES-01", topic = "Respiration", quick = true, q = "Where in the cell does glycolysis take place?", o = { "cytoplasm", "mitochondrial matrix", "inner mitochondrial membrane", "intermembrane space" }, a = 1, x = "Glycolysis happens in the cytoplasm and doesn't need oxygen. Pyruvate then enters the mitochondrial matrix for the link reaction and Krebs cycle." },
			{ id = "HB-RES-03", topic = "Respiration", quick = false, q = "How many CO₂ molecules are released by the link reaction and Krebs cycle together, per glucose?", o = { "6", "2", "4", "8" }, a = 1, x = "Each pyruvate loses 1 CO₂ in the link reaction and 2 in the Krebs cycle. Glucose gives 2 pyruvate, so 2 × 3 = 6, accounting for all six carbon atoms." },
			{ id = "HB-RES-04", topic = "Respiration", quick = false, q = "Cyanide blocks the final enzyme of the electron transport chain. Why does the Krebs cycle also stop?", o = { "Reduced NAD and FAD can't be oxidised, so no NAD⁺ or FAD is available for the Krebs cycle.", "Cyanide binds directly to the Krebs cycle enzymes.", "There is no oxygen to react with acetyl CoA.", "ATP builds up and inhibits the cycle." }, a = 1, x = "With the chain blocked, electrons can't pass to O₂, so reduced NAD and FAD aren't oxidised. The Krebs cycle needs NAD⁺ and FAD as hydrogen acceptors, so it stops too." },
			{ id = "HB-RES-05", topic = "Respiration", quick = false, q = "During intense exercise, muscle cells convert pyruvate to lactate. What is the main purpose of this?", o = { "to regenerate NAD⁺ so glycolysis can continue", "to produce extra ATP from pyruvate", "to store energy for later use", "to provide oxygen for the electron transport chain" }, a = 1, x = "When O₂ is short, reduced NAD can't be oxidised by the electron transport chain. Reducing pyruvate to lactate oxidises reduced NAD back to NAD⁺, so glycolysis keeps making its 2 ATP. The step itself makes no ATP." },
			{ id = "HB-RES-06", topic = "Respiration", quick = false, q = "An uncoupler makes the inner mitochondrial membrane leaky to H⁺. What happens to oxygen uptake and ATP synthesis?", o = { "Oxygen uptake continues or rises, but ATP synthesis falls and more energy is released as heat.", "Both oxygen uptake and ATP synthesis stop.", "Oxygen uptake stops, but ATP synthesis continues.", "Both rise." }, a = 1, x = "Electron transport, and so O₂ use, continues and may speed up. Protons leak back without passing through ATP synthase, so the gradient's energy is lost as heat instead of making ATP." },
			{ id = "HB-SIG-02", topic = "Cell Signalling", quick = true, q = "What type of receptor does glucagon bind to on liver cells?", o = { "G protein-coupled receptor", "receptor tyrosine kinase", "ligand-gated ion channel", "intracellular receptor in the nucleus" }, a = 1, x = "Glucagon binds a GPCR, activating a G protein, then adenylyl cyclase and cAMP. Insulin uses a receptor tyrosine kinase." },
			{ id = "HB-SIG-03", topic = "Cell Signalling", quick = false, q = "How can a tiny amount of glucagon release a large amount of glucose from a liver cell?", o = { "Each activated enzyme in the cascade activates many molecules of the next, amplifying the signal.", "Each glucagon molecule binds thousands of receptors.", "Glucagon is converted directly into glucose.", "Glucagon enters the cell and is copied." }, a = 1, x = "One receptor activates many G proteins; each adenylyl cyclase makes many cAMP; each protein kinase phosphorylates many enzymes. The number of active molecules multiplies at each step." },
			{ id = "HB-SIG-04", topic = "Cell Signalling", quick = false, q = "What happens straight after insulin binds to its receptor tyrosine kinase?", o = { "Two receptor subunits come together and phosphorylate each other's tyrosine residues, so relay proteins can bind.", "A G protein exchanges GDP for GTP.", "Adenylyl cyclase makes cAMP.", "The receptor enters the nucleus and acts as a transcription factor." }, a = 1, x = "Ligand binding brings the receptor subunits together and activates their kinase domains, which cross-phosphorylate tyrosines. Phosphotyrosines act as docking sites for relay proteins, eventually moving GLUT4 to the cell surface." },
			{ id = "HB-SIG-05", topic = "Cell Signalling", quick = false, q = "A mutation stops the Gα subunit from hydrolysing GTP. A liver cell is exposed to glucagon briefly, then glucagon is removed. What happens?", o = { "Adenylyl cyclase stays active, so cAMP stays high and glycogen breakdown continues.", "Adenylyl cyclase is never activated.", "The cell responds normally and stops when glucagon is removed.", "Glycogen synthesis increases." }, a = 1, x = "Gα switches off by hydrolysing its bound GTP to GDP. If it can't, it stays active even after the hormone leaves, so the response doesn't shut down. Cholera toxin acts in a similar way in gut cells." },
			{ id = "HB-NAT-01", topic = "Natural Selection", quick = true, q = "What is the original source of new alleles in a population?", o = { "mutation", "crossing over", "independent assortment", "natural selection" }, a = 1, x = "Only mutation creates new alleles. Crossing over and independent assortment reshuffle existing alleles into new combinations; natural selection changes allele frequencies." },
			{ id = "HB-NAT-02", topic = "Natural Selection", quick = true, q = "Human babies of intermediate birth weight have the highest survival rate. What type of selection is this?", o = { "stabilising selection", "directional selection", "disruptive selection", "artificial selection" }, a = 1, x = "Selection against both extremes keeps the mean the same and narrows the range: stabilising selection. Directional shifts the mean; disruptive favours both extremes." },
			{ id = "HB-NAT-03", topic = "Natural Selection", quick = false, q = "Which statement correctly explains how a bacterial population becomes resistant to an antibiotic?", o = { "A few bacteria already had a resistance allele by chance; the antibiotic kills the others, so resistant ones survive and reproduce.", "The antibiotic causes mutations that make the bacteria resistant.", "Bacteria become resistant after being exposed to the antibiotic and pass this on.", "Bacteria learn to avoid the antibiotic." }, a = 1, x = "Mutations arise randomly, before exposure. The antibiotic is the selection pressure: it doesn't cause resistance, it removes susceptible bacteria, so the frequency of the resistance allele rises." },
			{ id = "HB-NAT-04", topic = "Natural Selection", quick = false, q = "A flood kills most of a population at random, and the few survivors have much less genetic diversity. What is this an example of?", o = { "a bottleneck effect (genetic drift)", "the founder effect", "directional selection", "gene flow" }, a = 1, x = "A sudden random reduction in population size is a bottleneck, a form of genetic drift: allele frequencies change by chance, not because of fitness. The founder effect is when a small group starts a new population elsewhere." },
			{ id = "HB-NAT-05", topic = "Natural Selection", quick = false, q = "Why does the sickle cell allele stay common in regions where malaria is widespread?", o = { "Heterozygotes are more resistant to malaria than either homozygote, so both alleles are maintained.", "The sickle cell allele is dominant.", "Malaria causes the sickle cell mutation.", "People with sickle cell anaemia have more children." }, a = 1, x = "HbA HbS heterozygotes resist malaria and rarely have severe anaemia, so they have the highest fitness. Selection against both homozygotes (anaemia and malaria) keeps the allele in the population: heterozygote advantage." },
			{ id = "HB-SPE-01", topic = "Speciation and Classification", quick = true, q = "According to the biological species concept, what is a species?", o = { "a group of organisms that can interbreed in nature to produce fertile offspring", "a group of organisms that look alike", "a group of organisms that live in the same habitat", "a group of organisms with identical DNA" }, a = 1, x = "The biological species concept is based on reproductive isolation. Horses and donkeys can mate but their offspring (mules) are sterile, so they are separate species." },
			{ id = "HB-SPE-02", topic = "Speciation and Classification", quick = true, q = "A population of beetles is split by a new river. Over time the two groups can no longer interbreed. What kind of speciation is this?", o = { "allopatric", "sympatric", "artificial", "convergent" }, a = 1, x = "Allopatric speciation follows geographical isolation. With no gene flow, mutation, selection and drift act separately on each group until they become reproductively isolated." },
			{ id = "HB-SPE-03", topic = "Speciation and Classification", quick = false, q = "A tetraploid plant arises from a diploid species. Why can it be considered a new species straight away?", o = { "Crosses with the diploid parent produce triploid offspring, which are sterile.", "It is geographically isolated from the parent species.", "It cannot carry out photosynthesis.", "Tetraploid plants can only reproduce asexually." }, a = 1, x = "Gametes from the tetraploid (2n) and the diploid (n) give triploid (3n) offspring whose chromosomes can't pair evenly in meiosis, so they are sterile. Speciation happens in the same place: sympatric speciation." },
			{ id = "HB-SPE-05", topic = "Speciation and Classification", quick = true, q = "The number of amino acid differences in cytochrome c between species W and four other species is: P 12, Q 3, R 20, S 8. Which species shares the most recent common ancestor with W?", o = { "Q", "P", "R", "S" }, a = 1, x = "Differences accumulate over time after two lineages split, so the fewest differences (3, with Q) means the most recent common ancestor." },
			{ id = "HB-SPE-06", topic = "Speciation and Classification", quick = false, q = "Which feature do Archaea share with Eukarya but not with Bacteria?", o = { "DNA associated with histone proteins", "70S ribosomes", "a circular chromosome", "a membrane-bound nucleus" }, a = 1, x = "Most archaea package DNA with histones, as eukaryotes do; bacteria don't. 70S ribosomes and circular chromosomes are shared by Archaea and Bacteria, and only eukaryotes have a nucleus." },
			{ id = "HB-INF-01", topic = "Infectious Diseases", quick = true, q = "Which cells secrete antibodies?", o = { "plasma cells", "memory B cells", "helper T cells", "macrophages" }, a = 1, x = "Activated B cells divide and differentiate into plasma cells, which have extensive rough ER for secreting antibodies. Memory B cells remain for future responses." },
			{ id = "HB-INF-02", topic = "Infectious Diseases", quick = true, q = "Which part of an antibody determines which antigen it binds?", o = { "the variable regions at the tips of the heavy and light chains", "the constant region of the heavy chains", "the disulfide bonds joining the chains", "the hinge region" }, a = 1, x = "Each antibody has two antigen-binding sites formed by the variable regions, whose amino acid sequence differs between antibodies. The constant region interacts with phagocytes and complement." },
			{ id = "HB-INF-03", topic = "Infectious Diseases", quick = false, q = "A baby receives antibodies from its mother across the placenta. What type of immunity is this?", o = { "natural passive immunity", "natural active immunity", "artificial passive immunity", "artificial active immunity" }, a = 1, x = "It is passive because the baby didn't make the antibodies, and natural because no medical treatment was involved. A vaccine gives artificial active immunity." },
			{ id = "HB-INF-04", topic = "Infectious Diseases", quick = false, q = "Why is the secondary immune response faster and larger than the primary response?", o = { "Memory cells made in the first response recognise the antigen and divide quickly.", "Antibodies from the first infection stay in the blood for life.", "The pathogen is weaker the second time.", "Macrophages remember the pathogen." }, a = 1, x = "Clonal expansion in the primary response leaves many long-lived memory B and T cells. On re-exposure they respond rapidly, producing more antibody sooner, often before symptoms appear." },
			{ id = "HB-INF-05", topic = "Infectious Diseases", quick = false, q = "Why is tuberculosis treated with several antibiotics taken together for at least six months?", o = { "Mycobacterium tuberculosis grows slowly and hides in macrophages, and using several drugs makes it unlikely that a resistant mutant survives all of them.", "Each antibiotic kills only one type of white blood cell.", "TB is caused by a virus, so it needs several drugs.", "The antibiotics are only effective after six months." }, a = 1, x = "Slow growth and survival inside macrophages make the bacteria hard to clear. A bacterium would need resistance to every drug at once to survive, and finishing the full course stops partly resistant survivors from multiplying." },
			{ id = "HB-INF-06", topic = "Infectious Diseases", quick = false, q = "Why does HIV infection weaken both antibody (humoral) and cell-mediated responses?", o = { "HIV destroys helper T cells, which are needed to activate both B cells and cytotoxic T cells.", "HIV destroys all B cells directly.", "HIV antibodies block every other antibody.", "HIV infects red blood cells, reducing oxygen supply to the immune system." }, a = 1, x = "HIV infects CD4⁺ helper T cells. Without their cytokines, B cells aren't activated to become plasma cells and cytotoxic T cells aren't activated, so opportunistic infections take hold (AIDS)." },
			{ id = "HB-INF-07", topic = "Infectious Diseases", quick = false, q = "Why is penicillin most effective against bacteria that are actively growing and dividing?", o = { "It blocks the cross-linking of new peptidoglycan, so growing cells make weak walls and burst by osmosis.", "It blocks bacterial 70S ribosomes, which are only active during division.", "It digests the existing cell wall of any bacterium.", "It damages bacterial DNA as it replicates." }, a = 1, x = "Penicillin inhibits the enzymes (transpeptidases) that cross-link peptidoglycan. Only cells building new wall are affected; their weakened walls can't resist osmotic water entry, so they lyse. Human cells have no walls, so they aren't harmed." },
			{ id = "HB-CLI-01", topic = "Climate Change", quick = true, q = "Which greenhouse gas is released in the largest amount by burning fossil fuels?", o = { "carbon dioxide", "methane", "water vapour", "ozone" }, a = 1, x = "Burning coal, oil and gas oxidises their carbon to CO₂, which is the main driver of human-caused warming." },
			{ id = "HB-CLI-02", topic = "Climate Change", quick = true, q = "What causes coral bleaching when sea temperatures rise?", o = { "Corals expel the photosynthetic algae (zooxanthellae) living in their tissues.", "The coral skeleton dissolves.", "Corals produce less pigment because there is less light.", "Bacteria in warm water digest the coral." }, a = 1, x = "Heat stress makes the zooxanthellae produce harmful reactive oxygen species, so the coral expels them. Corals lose their colour and their main food supply, and may starve if the heat continues." },
			{ id = "HB-CLI-03", topic = "Climate Change", quick = false, q = "How does rising atmospheric CO₂ harm shell-forming marine animals?", o = { "More CO₂ dissolves to form carbonic acid, lowering pH and reducing the carbonate ions needed to build calcium carbonate shells.", "CO₂ is toxic to animals with shells.", "CO₂ reduces the amount of oxygen dissolved in seawater.", "Warmer water makes calcium carbonate more soluble." }, a = 1, x = "CO₂ + H₂O → H₂CO₃ → H⁺ + HCO₃⁻. The extra H⁺ reacts with CO₃²⁻ to form more HCO₃⁻, so less carbonate is available for calcification, and acidic water can even dissolve existing shells." },
			{ id = "HB-CLI-04", topic = "Climate Change", quick = false, q = "Turtle eggs incubated at higher temperatures develop mostly into females. What is a likely effect of warming beaches?", o = { "sex ratios skewed towards females, which may reduce breeding success", "more males, which increases competition", "faster hatching with no change in sex ratio", "turtles switching to genetic sex determination within one generation" }, a = 1, x = "In temperature-dependent sex determination, warmer nests produce more females. Too few males can reduce mating success and genetic diversity. Animals can't switch their sex-determination system within a generation." },
			{ id = "HB-CLI-05", topic = "Climate Change", quick = false, q = "Warmer springs make caterpillars peak earlier, but a bird species still times its breeding by day length. What is the likely result?", o = { "Chicks hatch after the caterpillar peak and have less food, so fewer survive.", "Chicks hatch with more food than before.", "Birds start laying eggs earlier, matching the caterpillars.", "The caterpillar population falls because more chicks eat them." }, a = 1, x = "Day length doesn't change with climate, but temperature-driven events do. This phenological mismatch leaves chicks hatching when food is already declining." },
			{ id = "HB-CLI-06", topic = "Climate Change", quick = false, q = "Why does rising temperature reduce net photosynthesis in many C3 plants?", o = { "RuBisCO fixes O₂ instead of CO₂ more often as temperature rises, increasing photorespiration.", "Chlorophyll is denatured at temperatures just above 25 °C.", "Higher temperatures stop the light-dependent reactions.", "Stomata stay fully open, so the plant takes in too much CO₂." }, a = 1, x = "As temperature rises, CO₂ becomes less soluble relative to O₂ and RuBisCO's oxygenase activity increases. Photorespiration wastes energy and releases fixed carbon as CO₂, lowering net carbon gain." },
		},
	},
	olymp = {
		name = "Maths Olympiad",
		constants = "",
		questions = {
			{ id = "MO-REM-06", topic = "Remainders", quick = false, q = "What is the remainder when the square of any prime greater than 3 is divided by 24?", o = { "1", "0", "5", "It depends on the prime." }, a = 1, x = "p² − 1 = (p − 1)(p + 1). These are consecutive even numbers, so one is a multiple of 4: the product is divisible by 8. One of p − 1, p, p + 1 is a multiple of 3, and it isn't p. So 24 divides p² − 1." },
			{ id = "MO-PRI-03", topic = "Primes", quick = true, q = "For how many primes p are p, p + 2 and p + 4 all prime?", o = { "exactly one", "none", "exactly two", "infinitely many" }, a = 1, x = "p, p + 2 and p + 4 leave three different remainders mod 3, so one of them is a multiple of 3. It must equal 3 itself, which forces p = 3: giving 3, 5, 7." },
			{ id = "MO-EQN-07", topic = "Equations and Identities", quick = false, q = "a and b are the roots of x² − 5x + 3 = 0. What is 1/a² + 1/b²?", o = { "19/9", "25/9", "5/3", "31/9" }, a = 1, x = "1/a² + 1/b² = (a² + b²)/(ab)². a² + b² = (a + b)² − 2ab = 25 − 6 = 19, and (ab)² = 9, giving 19/9. Forgetting the −2ab gives 25/9." },
			{ id = "MO-SEQ-04", topic = "Sequences and Series", quick = false, q = "What is 1/(1 × 2) + 1/(2 × 3) + 1/(3 × 4) + … + 1/(99 × 100)?", o = { "99/100", "1", "100/101", "1/100" }, a = 1, x = "Each term splits: 1/(n(n + 1)) = 1/n − 1/(n + 1). The sum telescopes to 1 − 1/100 = 99/100." },
			{ id = "MO-FUN-04", topic = "Functions and Polynomials", quick = false, q = "A polynomial p(x) has p(1) = 3 and p(2) = 5. What is the remainder when p(x) is divided by (x − 1)(x − 2)?", o = { "2x + 1", "x + 2", "3x + 2", "8" }, a = 1, x = "The remainder has degree below 2, so write it as ax + b. Then a + b = 3 and 2a + b = 5, giving a = 2, b = 1: 2x + 1." },
			{ id = "MO-PRB-01", topic = "Probability", quick = true, q = "Two fair dice are rolled. What is the probability that the total is 7?", o = { "1/6", "7/36", "1/12", "1/11" }, a = 1, x = "6 of the 36 equally likely outcomes give 7: (1, 6), (2, 5), (3, 4), (4, 3), (5, 2), (6, 1). 6/36 = 1/6. 1/11 wrongly treats the 11 totals as equally likely." },
			{ id = "MO-PRB-02", topic = "Probability", quick = true, q = "Three fair coins are tossed. What is the probability of getting at least one head?", o = { "7/8", "1/2", "3/8", "3/4" }, a = 1, x = "P(no heads) = (½)³ = 1/8, so P(at least one head) = 1 − 1/8 = 7/8." },
			{ id = "MO-PRB-03", topic = "Probability", quick = true, q = "A bag has 3 red and 5 blue balls. Two are drawn without replacement. What is the probability both are red?", o = { "3/28", "9/64", "3/8", "1/4" }, a = 1, x = "P = 3/8 × 2/7 = 6/56 = 3/28. With replacement it would be 9/64." },
			{ id = "MO-PRB-04", topic = "Probability", quick = false, q = "A two-digit number is chosen at random. What is the probability that it is a perfect square?", o = { "1/15", "1/10", "3/50", "7/90" }, a = 1, x = "The two-digit squares are 16, 25, 36, 49, 64, 81: 6 out of 90 numbers (10 to 99). 6/90 = 1/15." },
			{ id = "MO-PRB-05", topic = "Probability", quick = false, q = "Three fair dice are rolled. What is the probability that the total is 10?", o = { "1/8", "1/6", "5/72", "1/9" }, a = 1, x = "Count ordered triples from 1 to 6 summing to 10. The sets {1,3,6}, {1,4,5}, {2,3,5} give 6 orders each (18); {2,2,6}, {2,4,4}, {3,3,4} give 3 each (9). 27/216 = 1/8." },
			{ id = "MO-LOG-05", topic = "Logic and Pigeonhole", quick = false, q = "On an island, knights always tell the truth and knaves always lie. A says, 'B is a knave.' B says, 'A and I are the same type.' What are A and B?", o = { "A is a knight and B is a knave.", "A is a knave and B is a knight.", "Both are knights.", "Both are knaves." }, a = 1, x = "If A were a knave, B would be a knight; but then B's claim that they're the same type would be false, which a knight can't say. So A is a knight and B is a knave. B's claim is then false, which fits." },
			{ id = "MO-TRI-04", topic = "Triangles and Polygons", quick = false, q = "A right-angled triangle has legs 5 and 12. What is the length of the altitude to the hypotenuse?", o = { "60/13", "13/2", "30/13", "5" }, a = 1, x = "The hypotenuse is 13. Area = ½ × 5 × 12 = 30 = ½ × 13 × h, so h = 60/13." },
			{ id = "MO-TRI-08", topic = "Triangles and Polygons", quick = false, q = "In triangle ABC, D is on AB and E is on AC with DE parallel to BC and AD : DB = 2 : 3. What is the ratio of the area of triangle ADE to the area of quadrilateral DBCE?", o = { "4 : 21", "4 : 25", "2 : 3", "4 : 9" }, a = 1, x = "ADE is similar to ABC with scale factor AD/AB = 2/5, so its area is 4/25 of ABC. The quadrilateral is the remaining 21/25, giving 4 : 21. 4 : 25 compares ADE with the whole triangle." },
